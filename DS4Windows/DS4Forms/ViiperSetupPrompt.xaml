<Window x:Class="DS4WinWPF.DS4Forms.ViiperSetupPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        Title="{lex:Loc ViiperPrompt.WinTitle}"
        Width="620"
        SizeToContent="Height"
        MaxHeight="720"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBackgroundColor}"
        Foreground="{DynamicResource ForegroundColor}">
    <Border Background="{DynamicResource SurfaceBackgroundColor}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SidebarBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="8,8,0,0"
                    Padding="18,12"
                    PreviewMouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="{lex:Loc ViiperPrompt.WinTitle}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="closeButton"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Content="×"
                            FontSize="18"
                            Style="{StaticResource BridgeSecondaryButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="{lex:Loc ViiperPrompt.Close}" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="26,24,26,22">
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="{DynamicResource NavigationSelectionColor}"
                                BorderBrush="{DynamicResource AccentColor}"
                                BorderThickness="1">
                            <TextBlock Text="i"
                                       Foreground="{DynamicResource AccentColor}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="headingText"
                                       Text="{lex:Loc ViiperPrompt.Heading}"
                                       Style="{StaticResource BridgeSectionTitleStyle}"
                                       FontSize="20" />
                            <TextBlock x:Name="summaryText"
                                       Text="{lex:Loc ViiperPrompt.Summary}"
                                       Foreground="{DynamicResource MutedForegroundColor}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource BridgeCardStyle}"
                            Padding="16"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="requirementsHeadingText"
                                       Text="{lex:Loc ViiperPrompt.RequirementsHeading}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,7" />
                            <TextBlock x:Name="requirementsText"
                                       Text="{lex:Loc ViiperPrompt.RequirementsText}"
                                       TextWrapping="Wrap"
                                       LineHeight="22" />
                            <Border Height="1"
                                    Background="{DynamicResource BorderColor}"
                                    Margin="0,12,0,10" />
                            <TextBlock Text="{lex:Loc ViiperPrompt.CurrentStatus}"
                                       Foreground="{DynamicResource MutedForegroundColor}"
                                       FontSize="12" />
                            <TextBlock x:Name="statusText"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="existingViiperPanel"
                            Background="{DynamicResource RaisedBackgroundColor}"
                            BorderBrush="{DynamicResource AccentColor}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,16"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="existingViiperHeadingText"
                                       Text="{lex:Loc ViiperPrompt.ExistingHeading}"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="existingViiperDescriptionText"
                                       Text="{lex:Loc ViiperPrompt.ExistingDescription}"
                                       Foreground="{DynamicResource MutedForegroundColor}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,7" />
                            <TextBlock x:Name="existingViiperPathText"
                                       FontFamily="Consolas"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <CheckBox x:Name="suppressPromptCheck"
                              Content="{lex:Loc ViiperPrompt.SuppressPrompt}"
                              ToolTip="{lex:Loc ViiperPrompt.SuppressPromptTip}"
                              Style="{StaticResource BridgeDescribedCheckBoxStyle}"
                              Margin="0,0,0,20" />

                    <Border x:Name="portableWarningPanel"
                            Background="{DynamicResource RaisedBackgroundColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16">
                        <TextBlock Text="{lex:Loc ViiperPrompt.PortableWarning}"
                                   Foreground="{DynamicResource MutedForegroundColor}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="notNowButton"
                                Content="{lex:Loc ViiperPrompt.NotNow}"
                                MinWidth="94"
                                Style="{StaticResource BridgeSecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Click="NotNowButton_Click" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="installPortableButton"
                                    Content="{lex:Loc ViiperPrompt.InstallPortable}"
                                    MinWidth="132"
                                    Margin="0,0,10,0"
                                    Style="{StaticResource BridgeSecondaryButtonStyle}"
                                    Click="InstallPortableButton_Click" />
                            <Button x:Name="installButton"
                                    Content="{lex:Loc ViiperPrompt.InstallStandard}"
                                    MinWidth="164"
                                    Style="{StaticResource BridgePrimaryButtonStyle}"
                                    Click="InstallButton_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
