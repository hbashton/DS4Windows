<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle
      Name="DS4Windows"
      Manufacturer="DS4Windows"
      Version="$(var.BundleVersion)"
      UpgradeCode="BC70CCB1-AD65-42A0-B468-8A7278A37A62"
      IconSourceFile="$(var.ExtrasRoot)\..\DS4Windows\DS4W.ico"
      Compressed="yes"
      AboutUrl="https://github.com/hbashton/DS4Windows"
      HelpUrl="https://github.com/hbashton/DS4Windows/issues">

    <BootstrapperApplication SourceFile="$(var.BootstrapperRoot)\DS4Windows.Bootstrapper.exe">
      <Payload SourceFile="$(var.BootstrapperRoot)\DS4Windows.Bootstrapper.exe.config" />
      <Payload SourceFile="$(var.BootstrapperRoot)\mbanative.dll" />
      <Payload SourceFile="$(var.BootstrapperRoot)\WixToolset.BootstrapperApplicationApi.dll" />
    </BootstrapperApplication>

    <Variable Name="CreateDesktopShortcut" Type="numeric" Value="1" />
    <Variable Name="InstallHidHide" Type="numeric" Value="1" />
    <Variable Name="InstallFakerInput" Type="numeric" Value="0" />
    <Variable Name="TargetUserSid" Type="string" Value="" Persisted="yes" />
    <Variable Name="TargetUserName" Type="string" Value="" Persisted="yes" />
    <Variable Name="TargetLocalAppData" Type="string" Value="" Persisted="yes" />
    <Variable Name="TargetRoamingAppData" Type="string" Value="" Persisted="yes" />

    <util:RegistrySearch
        Id="InfrastructureMarkerSearch"
        Variable="InfrastructureInstalled"
        Root="HKLM"
        Key="SOFTWARE\DS4Windows"
        Value="InfrastructureVersion"
        Result="value"
        Bitness="always64" />
    <util:RegistrySearch
        Id="ManagedInstallRegistrationSearch"
        Variable="ManagedInstallRegistered"
        Root="HKLM"
        Key="SOFTWARE\DS4Windows"
        Value="InstallPath"
        Result="exists"
        Bitness="always64" />
    <util:FileSearch
        Id="ManagedViiperExecutableSearch"
        Variable="ManagedViiperPresent"
        Path="[ProgramFiles64Folder]DS4Windows\VIIPER\viiper.exe"
        Result="exists" />
    <util:RegistrySearch
        Id="HidHideSearch"
        Variable="HidHideInstalled"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{01E0AB21-D1CC-42B4-9DFF-84FFE4F26DAF}"
        Value="DisplayVersion"
        Result="value"
        Bitness="always64" />

    <Chain>
      <ExePackage
          Id="CloseRunningApplications"
          CacheId="DS4WindowsSetupActionsPreflight-$(var.SetupActionsHash)"
          Name="DS4Windows.SetupActions.Preflight.exe"
          SourceFile="$(var.SetupActionsPath)"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          DetectCondition="0"
          InstallArguments="preflight">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <MsiPackage
          Id="DS4WindowsMsi"
          SourceFile="$(var.MsiPath)"
          Visible="no"
          Vital="yes">
        <MsiProperty Name="DESKTOP_SHORTCUT" Value="[CreateDesktopShortcut]" />
      </MsiPackage>

      <ExePackage
          Id="ViiperUsbipSetup"
          CacheId="DS4WindowsSetupActionsInfrastructure-$(var.SetupActionsHash)"
          SourceFile="$(var.SetupActionsPath)"
          PerMachine="yes"
          Vital="yes"
          DetectCondition="InfrastructureInstalled = &quot;VIIPER-0.0.8+USBIP-0.9.7.7&quot; OR ManagedInstallRegistered OR ManagedViiperPresent"
          InstallArguments="install --install-root &quot;[ProgramFiles64Folder]DS4Windows&quot; --bundle-source &quot;[WixBundleOriginalSource]&quot; --target-user-sid &quot;[TargetUserSid]&quot; --target-user-name &quot;[TargetUserName]&quot; --target-local-appdata &quot;[TargetLocalAppData]&quot; --target-roaming-appdata &quot;[TargetRoamingAppData]&quot;"
          RepairArguments="repair --install-root &quot;[ProgramFiles64Folder]DS4Windows&quot; --bundle-source &quot;[WixBundleOriginalSource]&quot; --target-user-sid &quot;[TargetUserSid]&quot; --target-user-name &quot;[TargetUserName]&quot; --target-local-appdata &quot;[TargetLocalAppData]&quot; --target-roaming-appdata &quot;[TargetRoamingAppData]&quot;"
          UninstallArguments="uninstall --install-root &quot;[ProgramFiles64Folder]DS4Windows&quot;">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <ExePackage
          Id="HidHide"
          SourceFile="$(var.ExtrasRoot)\HidHide_1.5.230_x64.exe"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          DetectCondition="HidHideInstalled"
          InstallCondition="InstallHidHide"
          InstallArguments="/quiet /norestart">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <MsiPackage
          Id="FakerInput"
          SourceFile="$(var.ExtrasRoot)\FakerInput_0.1.0_x64.msi"
          Permanent="yes"
          Vital="yes"
          InstallCondition="InstallFakerInput"
          Visible="no" />

      <!-- Burn removes packages in reverse chain order. Keep a second,
           install-only invocation of the verified preflight helper at the
           tail so uninstall quiesces DS4Windows and VIIPER before any owned
           package is removed. The BA plans exactly one of the two preflights. -->
      <ExePackage
          Id="CloseRunningApplicationsForUninstall"
          CacheId="DS4WindowsSetupActionsUninstallPreflight-$(var.SetupActionsHash)"
          Name="DS4Windows.SetupActions.UninstallPreflight.exe"
          SourceFile="$(var.SetupActionsPath)"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          DetectCondition="0"
          InstallArguments="preflight">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="error" />
      </ExePackage>
    </Chain>
  </Bundle>
</Wix>
