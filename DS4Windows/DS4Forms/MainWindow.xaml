                                            <CheckBox Content="{lex:Loc FlashLightbarAtHighLatency}" VerticalAlignment="Center" IsChecked="{Binding FlashHighLatency}" Style="{DynamicResource BridgeLabeledCheckBoxStyle}" Margin="0" />
