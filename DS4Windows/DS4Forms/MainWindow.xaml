                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Startup, window behavior and notifications." Style="{DynamicResource BridgeSectionDescriptionStyle}" Margin="0,0,0,16" />
