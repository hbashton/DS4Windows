<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>DS4Windows.SetupActions</AssemblyName>
    <RootNamespace>DS4Windows.SetupActions</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(ViiperNativeBundleEnabled)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ViiperNativeSourceRevision</_Parameter1>
      <_Parameter2>$(ViiperNativeSourceRevision)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ViiperNativeDriverPackageVersion</_Parameter1>
      <_Parameter2>$(ViiperNativeDriverPackageVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ViiperNativeDriverBuildIdentity</_Parameter1>
      <_Parameter2>$(ViiperNativeDriverBuildIdentity)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ViiperNativeBrokerSha256</_Parameter1>
      <_Parameter2>$(ViiperNativeBrokerSha256)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ViiperNativeHelperSha256</_Parameter1>
      <_Parameter2>$(ViiperNativeHelperSha256)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ViiperNativeManifestSha256</_Parameter1>
      <_Parameter2>$(ViiperNativeManifestSha256)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ViiperNativeInfSha256</_Parameter1>
      <_Parameter2>$(ViiperNativeInfSha256)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ViiperNativeSysSha256</_Parameter1>
      <_Parameter2>$(ViiperNativeSysSha256)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ViiperNativeCatSha256</_Parameter1>
      <_Parameter2>$(ViiperNativeCatSha256)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ViiperNativeLockSha256</_Parameter1>
      <_Parameter2>$(ViiperNativeLockSha256)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="ValidateNativeViiperPackagePins"
          BeforeTargets="GenerateAssemblyInfo"
          Condition="'$(ViiperNativeBundleEnabled)' == 'true'">
    <PropertyGroup>
      <_ViiperNativeHashPins>$(ViiperNativeDriverBuildIdentity);$(ViiperNativeBrokerSha256);$(ViiperNativeHelperSha256);$(ViiperNativeManifestSha256);$(ViiperNativeInfSha256);$(ViiperNativeSysSha256);$(ViiperNativeCatSha256);$(ViiperNativeLockSha256)</_ViiperNativeHashPins>
    </PropertyGroup>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ViiperNativeSourceRevision)', '^(?:[0-9a-f]{40}|[0-9a-f]{64})$'))"
           Text="ViiperNativeSourceRevision must be canonical lowercase hexadecimal." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(ViiperNativeDriverPackageVersion)', '^\d+\.\d+\.\d+\.\d+$'))"
           Text="ViiperNativeDriverPackageVersion must be a four-part numeric version." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_ViiperNativeHashPins)', '^[0-9a-f]{64}(?:;[0-9a-f]{64}){7}$'))"
           Text="Every native VIIPER identity/file/lock pin must be canonical lowercase SHA-256." />
  </Target>
</Project>
