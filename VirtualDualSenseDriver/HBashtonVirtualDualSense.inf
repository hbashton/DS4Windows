;
; HBashtonVirtualDualSense.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
CatalogFile=HBashtonVirtualDualSense.cat
DriverVer=06/11/2026,0.1.0.0
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
HBashtonVirtualDualSense.sys = 1,,

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DeviceName%=HBashtonVirtualDualSense_Device, Root\HBashtonVirtualDualSense

[HBashtonVirtualDualSense_Device.NT]
CopyFiles=Drivers_Dir
AddReg=HBashtonVirtualDualSense_AddReg

[Drivers_Dir]
HBashtonVirtualDualSense.sys

[HBashtonVirtualDualSense_AddReg]
HKR,,"LowerFilters",0x00010000,"vhf"

[HBashtonVirtualDualSense_Device.NT.Services]
AddService=HBashtonVirtualDualSense,0x00000002,HBashtonVirtualDualSense_Service_Inst

[HBashtonVirtualDualSense_Service_Inst]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\HBashtonVirtualDualSense.sys

[HBashtonVirtualDualSense_Device.NT.Wdf]
KmdfService=HBashtonVirtualDualSense,HBashtonVirtualDualSense_wdfsect

[HBashtonVirtualDualSense_wdfsect]
KmdfLibraryVersion=1.33

[Strings]
ManufacturerName="hbashton"
DiskName="HBashton Virtual DualSense Installation Disk"
DeviceName="HBashton Virtual DualSense Controller Bus"
ServiceName="HBashton Virtual DualSense Controller Bus"
