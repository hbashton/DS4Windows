                            <TextBlock Text="Loading profile editor" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Applying the profile and preparing its controls..."
                                       Margin="0,7,0,16" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                            <ProgressBar IsIndeterminate="True" Height="4" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="{lex:Loc AutoProfiles}" Tag="&#xE823;" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <local:AutoProfiles x:Name="autoProfControl">

