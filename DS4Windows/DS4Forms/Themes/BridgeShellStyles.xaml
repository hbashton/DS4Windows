<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        DS5 Bridge-inspired application shell.

        This dictionary only owns layout and component geometry. Theme colors live in
        DefaultTheme.xaml and DarkTheme.xaml so the existing runtime theme switch keeps
        working without rebuilding any views.
    -->

    <Style x:Key="BridgeCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <Style x:Key="BridgeSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="BridgeSectionDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="BridgePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style x:Key="BridgeSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="34" />
    </Style>

    <Style x:Key="BridgeDescribedCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource CheckBoxStyle}">
        <Setter Property="Margin" Value="4,2,4,13" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Margin="3,0,0,0">
                        <TextBlock Text="{Binding}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ForegroundColor}" />
                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=CheckBox}, Path=ToolTip}"
                                   Margin="0,3,0,0" MaxWidth="620" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource MutedForegroundColor}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BridgeControllerCardItemStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="Card"
                            Background="{DynamicResource CardBackgroundColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="18">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SuccessColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BridgeNavigationTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="NavItem"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0"
                            CornerRadius="3"
                            Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NavGlyph"
                                       Text="◇"
                                       Foreground="{DynamicResource MutedForegroundColor}"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavItem" Property="Background" Value="{DynamicResource RaisedBackgroundColor}" />
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="NavItem" Property="Background" Value="{DynamicResource NavigationSelectionColor}" />
                            <Setter TargetName="NavItem" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            <Setter TargetName="NavGlyph" Property="Text" Value="◆" />
                            <Setter TargetName="NavGlyph" Property="Foreground" Value="{DynamicResource AccentColor}" />
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BridgeMainTabControlStyle" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource BridgeNavigationTabItemStyle}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceBackgroundColor}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="{DynamicResource SurfaceBackgroundColor}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="238" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Background="{DynamicResource SidebarBackgroundColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="0,0,1,0">
                            <Grid Margin="18,18,18,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Margin="4,0,0,20">
                                    <Border Width="30" Height="30" CornerRadius="5"
                                            Background="{DynamicResource AccentColor}" Margin="0,0,10,0">
                                        <TextBlock Text="D" Foreground="White" FontSize="17" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="DS4Windows" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource ForegroundColor}" />
                                        <TextBlock Text="Controller companion" FontSize="10"
                                                   Foreground="{DynamicResource MutedForegroundColor}" />
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundColor}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        CornerRadius="4" Padding="10" Margin="0,0,0,18">
                                    <Grid>
                                        <ItemsControl x:Name="SidebarControllerList" ItemsSource="{Binding ControllerCol}" MaxHeight="110">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Source="{Binding StatusSource}" Width="15" Height="15" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding IdText}" TextTrimming="CharacterEllipsis"
                                                                   FontSize="11" Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding BatteryState}" Margin="6,0,0,0"
                                                                   FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SuccessColor}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Connect a controller to begin" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundColor}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ElementName=SidebarControllerList, Path=HasItems}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <TextBlock Grid.Row="2" Text="NAVIGATION" Margin="10,0,0,8"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundColor}" />
                                <TabPanel Grid.Row="3" IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" />

                                <StackPanel Grid.Row="4" Margin="8,14,8,0">
                                    <Separator Background="{DynamicResource BorderColor}" Margin="0,0,0,12" />
                                    <TextBlock Text="All legacy features remain available"
                                               TextWrapping="Wrap" FontSize="10"
                                               Foreground="{DynamicResource MutedForegroundColor}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="84" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1"
                                    Padding="28,16" Background="{DynamicResource SurfaceBackgroundColor}">
                                <StackPanel VerticalAlignment="Center">
                                    <ContentControl Content="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}"
                                                    Foreground="{DynamicResource ForegroundColor}"
                                                    FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedItem.Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                               Margin="0,3,0,0" FontSize="12"
                                               Foreground="{DynamicResource MutedForegroundColor}" />
                                </StackPanel>
                            </Border>
                            <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent" Margin="28,22" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BridgeProfileTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="ProfileNavItem" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="3,0,0,0"
                            CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <StackPanel>
                            <ContentPresenter ContentSource="Header" />
                            <TextBlock Text="{TemplateBinding Tag}" Margin="0,2,0,0" FontSize="10"
                                       TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ProfileNavItem" Property="Background" Value="{DynamicResource RaisedBackgroundColor}" />
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ProfileNavItem" Property="Background" Value="{DynamicResource NavigationSelectionColor}" />
                            <Setter TargetName="ProfileNavItem" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BridgeProfileTabControlStyle" TargetType="TabControl">
        <Setter Property="TabStripPlacement" Value="Left" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource BridgeProfileTabItemStyle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="168" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource SidebarBackgroundColor}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0"
                                Padding="10">
                            <StackPanel>
                                <TextBlock Text="PROFILE SETTINGS" Margin="8,4,0,10"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource MutedForegroundColor}" />
                                <TabPanel IsItemsHost="True" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource SurfaceBackgroundColor}" Padding="14">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
