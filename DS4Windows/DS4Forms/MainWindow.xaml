                                <Border Style="{DynamicResource BridgeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Updates" Style="{DynamicResource BridgeSectionTitleStyle}" />
                                        <TextBlock Text="Check this fork for new releases." Style="{DynamicResource BridgeSectionDescriptionStyle}" />
                                        <CheckBox Content="{lex:Loc CheckUpdateStartup}" Margin="{StaticResource spaceMargin}" IsEnabled="{Binding SystemIntegrationEnabled}" IsChecked="{Binding CheckForUpdates}" ToolTip="Periodically check GitHub for a newer DS4Windows release." Style="{DynamicResource BridgeSettingsCheckBoxStyle}" />
                                        <StackPanel x:Name="checkEveryOptionsStack" Orientation="Horizontal" Margin="{StaticResource spaceMargin}" IsEnabled="{Binding CheckForUpdates}">
                                            <Label Content="{lex:Loc CheckEvery}" VerticalAlignment="Center" Padding="0" />
                                            <xctk:IntegerUpDown d:IsHidden="True" Value="{Binding CheckEvery}" MinWidth="80" Margin="8,0,0,0" ButtonSpinnerLocation="Right" Increment="1" Maximum="30" Minimum="0" MinHeight="34" VerticalContentAlignment="Center" />
                                            <ComboBox SelectedIndex="{Binding CheckEveryUnit,FallbackValue=1}" Margin="8,0,0,0" Foreground="{DynamicResource ForegroundColor}" MinWidth="60" Style="{DynamicResource BridgeSettingsComboBoxStyle}">
                                                <ComboBoxItem Content="{lex:Loc Hours}" />
                                                <ComboBoxItem Content="{lex:Loc Days}" />
                                            </ComboBox>
                                        </StackPanel>
                                        <WrapPanel>
                                            <Button x:Name="checkUpdatesBtn" Margin="0,0,10,10" Style="{DynamicResource BridgeSecondaryButtonStyle}" IsEnabled="{Binding SystemIntegrationEnabled}" Click="CheckUpdatesBtn_Click" HorizontalAlignment="Left" Content="{lex:Loc CheckUpdateNow}" VerticalAlignment="Center" />
                                            <Button x:Name="checklogViewBtn" Style="{DynamicResource BridgeSecondaryButtonStyle}" Click="ChecklogViewBtn_Click" Margin="0,0,10,10" HorizontalAlignment="Left" Content="{lex:Loc Changelog}" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource BridgeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Tools" Style="{DynamicResource BridgeSectionTitleStyle}" />
                                        <TextBlock Text="Open your profiles, test controller input or manage installed drivers." Style="{DynamicResource BridgeSectionDescriptionStyle}" />
                                        <WrapPanel>
                                            <Button x:Name="profFolderBtn" Margin="0,0,10,10" Style="{DynamicResource BridgeSecondaryButtonStyle}" Click="ProfFolderBtn_Click" HorizontalAlignment="Left" Content="{lex:Loc ProfileFolder}" VerticalAlignment="Center" />
                                            <Button x:Name="controlPanelBtn" Margin="0,0,10,10" Style="{DynamicResource BridgeSecondaryButtonStyle}" Click="ControlPanelBtn_Click" HorizontalAlignment="Left" Content="{lex:Loc ControlPanel}" VerticalAlignment="Center" />
                                            <Button x:Name="html5GameBtn" Margin="0,0,10,10" Style="{DynamicResource BridgeSecondaryButtonStyle}" Click="Html5GameBtn_Click" HorizontalAlignment="Left" Content="{lex:Loc GamepadTest}" VerticalAlignment="Center" />
                                            <Button x:Name="xinputCheckerBtn" Margin="0,0,10,10" Style="{DynamicResource BridgeSecondaryButtonStyle}" Click="XinputCheckerBtn_Click" HorizontalAlignment="Left" Content="{lex:Loc XInputChecker}" VerticalAlignment="Center" />
                                            <Button x:Name="driverSetupBtn" Margin="0,0,10,10" Style="{DynamicResource BridgeSecondaryButtonStyle}" IsEnabled="{Binding SystemIntegrationEnabled}" Click="DriverSetupBtn_Click" HorizontalAlignment="Left" Content="{lex:Loc DriverSetup}" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource BridgeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Diagnostics" Style="{DynamicResource BridgeSectionTitleStyle}" />
                                        <TextBlock Text="Enable detailed logging only while investigating a problem." Style="{DynamicResource BridgeSectionDescriptionStyle}" />
                                        <CheckBox x:Name="verboseLoggingCheck" Content="Verbose logging" Margin="{StaticResource spaceMargin}" IsChecked="{Binding VerboseStartupLogging}" ToolTip="Writes detailed diagnostic markers to the log. Disable after testing." Style="{DynamicResource BridgeSettingsCheckBoxStyle}" />
                                        <Button Content="Open log" HorizontalAlignment="Left" Style="{DynamicResource BridgeSecondaryButtonStyle}" Click="OpenSettingsLog_Click" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            <Border Margin="0,16,0,4" Padding="14,12" CornerRadius="6"
                                Background="{DynamicResource RaisedBackgroundColor}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Support DS4Windows" FontWeight="SemiBold" />
                                    <TextBlock Text="Help fund controller hardware, testing, and development."
                                               Margin="0,3,18,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedForegroundColor}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="❤  PayPal" Padding="14,7"
                                        VerticalAlignment="Center" Click="SupportPayPalBtn_Click" />
                            </Grid>
                        </Border>
</StackPanel>
                            <StackPanel x:Name="settingsIntegrationsPage">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=settingsIntegrationsNav}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Connect compatible games and external tools to DS4Windows." Style="{DynamicResource BridgeSectionDescriptionStyle}" Margin="0,0,0,16" />
                                <Border Style="{DynamicResource BridgeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Game mod support (DSX)" Style="{DynamicResource BridgeSectionTitleStyle}" />
                                        <TextBlock Text="Allow compatible local mods to control triggers and lights." Style="{DynamicResource BridgeSectionDescriptionStyle}" />
                                        <CheckBox x:Name="useDSXUdpServerCk" Content="Let game mods control triggers and lights" IsChecked="{Binding UseDSXUDPServer}" Click="UseDSXUdpServerCk_Click" Style="{DynamicResource BridgeLabeledCheckBoxStyle}" Margin="{StaticResource spaceMargin}" />
                                        <TextBlock Text="For compatible DSX game mods on this PC and a DualSense or DualSense Edge. Trigger Lab takes priority on each trigger you enable. This does not stream audio haptics." Margin="0,6,0,6" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" />
                                        <TextBlock x:Name="dsxUdpStatusText" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <Expander Header="Connection details" IsEnabled="{Binding UseDSXUDPServer}">
                                            <StackPanel Margin="0,6,0,0">
                                                <TextBlock Text="Use the same address and port in your mod. Most mods use 127.0.0.1 and port 6969. Close DSX or another listener using that port first." TextWrapping="Wrap" Margin="0,0,0,6" />
                                                <WrapPanel VerticalAlignment="Center">
                                                    <Label Content="This PC address" Padding="0" VerticalAlignment="Center" />
                                                    <TextBox x:Name="dsxUdpServerTxt" MinWidth="110" Margin="8,0,0,0" Text="{Binding DSXUdpIpAddress, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" MinHeight="34" VerticalContentAlignment="Center" />
                                                    <Label Content="Port" Padding="0" Margin="16,0,0,0" VerticalAlignment="Center" />
                                                    <xctk:IntegerUpDown x:Name="dsxUpdPortNum" MinWidth="80" Margin="8,0,0,0" Value="{Binding DSXUdpPort, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}" ButtonSpinnerLocation="Right" Increment="1" Maximum="65535" Minimum="1" MinHeight="34" VerticalContentAlignment="Center" />
                                                    <Button x:Name="dsxUdpApplyBtn" Content="Apply / Retry" Margin="0,0,10,10" Click="DSXUdpApplyBtn_Click" Style="{DynamicResource BridgeSecondaryButtonStyle}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource BridgeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="UDP server" Style="{DynamicResource BridgeSectionTitleStyle}" />
                                        <TextBlock Text="Share controller and motion input with compatible applications." Style="{DynamicResource BridgeSectionDescriptionStyle}" />
                                        <CheckBox x:Name="useUdpServerCk" Content="{lex:Loc MainWin.EnableServer}" IsChecked="{Binding UseUDPServer}" Click="UseUdpServerCk_Click" VerticalAlignment="Center" Style="{DynamicResource BridgeLabeledCheckBoxStyle}" Margin="{StaticResource spaceMargin}" />
                                        <WrapPanel>
                                            <StackPanel Width="180" Margin="0,8,16,8">
                                                <TextBlock Text="Listen address" Style="{DynamicResource BridgeSettingsFieldLabelStyle}" />
                                                <TextBox x:Name="udpServerTxt" IsEnabled="{Binding UseUDPServer,Mode=OneWay}" Text="{Binding UdpIpAddress, UpdateSourceTrigger=LostFocus,FallbackValue='127.0.0.1'}" MinHeight="34" VerticalContentAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Width="180" Margin="0,8,16,8">
                                                <TextBlock Text="Port" Style="{DynamicResource BridgeSettingsFieldLabelStyle}" />
                                                <xctk:IntegerUpDown d:IsHidden="True" x:Name="updPortNum" IsEnabled="{Binding UseUDPServer}" MinWidth="80" Value="{Binding UdpPort, UpdateSourceTrigger=LostFocus,FallbackValue='26760'}" ButtonSpinnerLocation="Right" Increment="1" Maximum="65535" Minimum="0" MinHeight="34" VerticalContentAlignment="Center" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <CheckBox Content="{lex:Loc UseSmoothing}" IsChecked="{Binding UseUdpSmoothing,FallbackValue='False'}" IsEnabled="{Binding UseUDPServer,Mode=OneWay}" Margin="0,4,0,10" Style="{DynamicResource BridgeLabeledCheckBoxStyle}" />
                                        <WrapPanel x:Name="udpEuroPanel" Margin="{StaticResource spaceMargin}" Visibility="{Binding UdpServerOneEuroPanelVisibility,FallbackValue='Collapsed'}">
                                            <StackPanel Orientation="Horizontal">
                                                <Label Content="{lex:Loc MainWin.OneEuroMinCutoff}" />
                                                <xctk:DoubleUpDown d:IsHidden="True" FormatString="F5" Value="{Binding UdpSmoothMinCutoff,FallbackValue=1.0,UpdateSourceTrigger=LostFocus}" Minimum="0.00001" Maximum="100.0" Increment="0.1" MinWidth="80" MinHeight="34" VerticalContentAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="30,0,0,0">
                                                <Label Content="{lex:Loc MainWin.OneEuroBeta}" />
                                                <xctk:DoubleUpDown d:IsHidden="True" FormatString="F5" Value="{Binding UdpSmoothBeta,FallbackValue=0.0,UpdateSourceTrigger=LostFocus}" Minimum="0.0" Maximum="1.0" Increment="0.1" MinWidth="80" MinHeight="34" VerticalContentAlignment="Center" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource BridgeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="OSC control and monitoring" Style="{DynamicResource BridgeSectionTitleStyle}" />
                                        <TextBlock Text="Receive external commands or send controller monitoring messages." Style="{DynamicResource BridgeSectionDescriptionStyle}" />
                                        <CheckBox x:Name="useOscServerCk" Content="{lex:Loc EnableOscServer}" IsChecked="{Binding UseOSCServer}" Click="UseOscServerCk_Click" VerticalAlignment="Center" Style="{DynamicResource BridgeLabeledCheckBoxStyle}" Margin="{StaticResource spaceMargin}" />
                                        <WrapPanel>
                                            <StackPanel Width="180" Margin="0,8,16,8">
                                                <TextBlock Text="Control port" Style="{DynamicResource BridgeSettingsFieldLabelStyle}" />
                                                <xctk:IntegerUpDown d:IsHidden="False" x:Name="oscPortNum" IsEnabled="{Binding UseOSCServer}" MinWidth="80" Value="{Binding OscPort, UpdateSourceTrigger=LostFocus,FallbackValue='9000'}" ButtonSpinnerLocation="Right" Increment="1" Maximum="65535" Minimum="0" MinHeight="34" VerticalContentAlignment="Center" />
                                            </StackPanel>
                                        </WrapPanel>
                                        <CheckBox x:Name="interpretingOscMonitoringCk" Content="{lex:Loc EnableInterpretingOscMonitoring}" Margin="0,4,0,10" IsChecked="{Binding InterpretingOscMonitoring}" IsEnabled="{Binding UseOSCServer}" Style="{DynamicResource BridgeLabeledCheckBoxStyle}" />
                                        <CheckBox x:Name="useOscSenderCk" Content="{lex:Loc EnableOscSender}" IsChecked="{Binding UseOSCSender}" Click="UseOscSenderCk_Click" VerticalAlignment="Center" Style="{DynamicResource BridgeLabeledCheckBoxStyle}" Margin="{StaticResource spaceMargin}" />
                                        <WrapPanel>
                                            <StackPanel Width="180" Margin="0,8,16,8">
                                                <TextBlock Text="Monitoring address" Style="{DynamicResource BridgeSettingsFieldLabelStyle}" />
                                                <TextBox x:Name="oscSenderTxt" IsEnabled="{Binding UseOSCSender,Mode=OneWay}" Text="{Binding OscSenderAddress, UpdateSourceTrigger=LostFocus,FallbackValue='127.0.0.1'}" MinHeight="34" VerticalContentAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Width="180" Margin="0,8,16,8">
                                                <TextBlock Text="Monitoring port" Style="{DynamicResource BridgeSettingsFieldLabelStyle}" />
                                                <xctk:IntegerUpDown d:IsHidden="False" x:Name="oscSendPort" IsEnabled="{Binding UseOSCSender}" MinWidth="80" Value="{Binding OscSendPort, UpdateSourceTrigger=LostFocus,FallbackValue='9000'}" ButtonSpinnerLocation="Right" Increment="1" Maximum="65535" Minimum="0" MinHeight="34" VerticalContentAlignment="Center" />
                                            </StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel x:Name="settingsAdvancedPage">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=settingsAdvancedNav}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Compatibility and process options. Defaults suit most users." Style="{DynamicResource BridgeSectionDescriptionStyle}" Margin="0,0,0,16" />
                                <Border Style="{DynamicResource BridgeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Steam compatibility" Style="{DynamicResource BridgeSectionTitleStyle}" />
                                        <TextBlock Text="Override the Steam folder only if automatic detection does not find your installation." Style="{DynamicResource BridgeSectionDescriptionStyle}" />
                                        <StackPanel Margin="{StaticResource spaceMargin}">
                                            <CheckBox x:Name="customSteamCk" Content="{lex:Loc UseCustomSteamFolder}" Margin="0,0,0,8" IsChecked="{Binding UseCustomSteamFolder}" Style="{DynamicResource BridgeLabeledCheckBoxStyle}" />
                                            <TextBox x:Name="customSteamTxt" Text="{Binding CustomSteamFolder, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding UseCustomSteamFolder}" MinHeight="34" VerticalContentAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource BridgeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Process options" Style="{DynamicResource BridgeSectionTitleStyle}" />
                                        <TextBlock Text="Use these overrides only when required by your setup." Style="{DynamicResource BridgeSectionDescriptionStyle}" />
                                        <DockPanel Margin="{StaticResource spaceMargin}">
                                            <Label Content="{lex:Loc CustomExeName}" VerticalAlignment="Center" Padding="0" Margin="0,0,16,0" />
                                            <Button x:Name="fakeExeNameExplainBtn" DockPanel.Dock="Right" Margin="8,0,0,0" Click="FakeExeNameExplainBtn_Click" Style="{DynamicResource BridgeSecondaryButtonStyle}" Padding="6" ToolTip="Why use a custom executable name?" VerticalAlignment="Center">
                                                <Image Source="{Binding QuestionMarkSource, Mode=OneTime}" Width="20" Height="20" Stretch="UniformToFill" />
                                            </Button>
                                            <TextBox x:Name="fakeExeNameTxt" Text="{Binding FakeExeName, UpdateSourceTrigger=LostFocus}" MinWidth="140" IsEnabled="{Binding SystemIntegrationEnabled}" MinHeight="34" VerticalContentAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock x:Name="executableRestartHint" Visibility="Collapsed" Margin="0,0,0,14" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" />
                                        <Grid Margin="{StaticResource spaceMargin}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label Content="{lex:Loc ProcessPriority}" ContentStringFormat="{}{0}:" VerticalAlignment="Center" Padding="0" Margin="0,0,16,0" />
                                            <ComboBox x:Name="ProcessPriorityComboBox" Margin="0" SelectedIndex="{Binding ProcessPriorityIndex}" SelectionChanged="ProcessPriorityComboBox_OnSelectionChanged" Grid.Column="1" Width="220" Style="{DynamicResource BridgeSettingsComboBoxStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource BridgeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Absolute mouse display" Style="{DynamicResource BridgeSectionTitleStyle}" />
                                        <TextBlock Text="Choose the display used by absolute mouse mappings." Style="{DynamicResource BridgeSectionDescriptionStyle}" />
                                        <Grid Margin="{StaticResource spaceMargin}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label Content="{lex:Loc MainWin.AbsDisplayMonitor}" ContentStringFormat="{}{0}:" VerticalAlignment="Center" Padding="0" Margin="0,0,16,0" />
                                            <ComboBox ItemsSource="{Binding AbsMonitorChoices}" DisplayMemberPath="DisplayItemString" SelectedValuePath="EDID" SelectedValue="{Binding AbsMonitorSettingEDID}" Margin="0" Grid.Column="1" Width="220" Style="{DynamicResource BridgeSettingsComboBoxStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem x:Name="logTab" Header="{lex:Loc Log}" Tag="&#xE9D9;">
                <DockPanel>
                    <Grid x:Name="logFooter" DockPanel.Dock="Bottom" Margin="4,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="copyLogBtn" Content="Copy Text" Margin="0,0,8,0"
                                Style="{DynamicResource BridgeSecondaryButtonStyle}" Click="CopyLogBtn_Click"
                                ToolTip="Copy the latest log entries as plain text for pasting into GitHub." />
                        <Button x:Name="exportLogBtn" Grid.Column="1" Content="{lex:Loc Export}" Style="{DynamicResource BridgeSecondaryButtonStyle}" Click="ExportLogBtn_Click" />
                        <Button x:Name="clearLogBtn" Grid.Column="3" Content="{lex:Loc Clear}" Style="{DynamicResource BridgeSecondaryButtonStyle}" Click="ClearLogBtn_Click" />
                        <TextBlock Grid.Column="2" Text="Latest 1,000 entries" VerticalAlignment="Center" Margin="16,0"
                                   Foreground="{DynamicResource MutedForegroundColor}"
                                   ToolTip="Older saved entries are available in the Logs folder." />
                    </Grid>
                    <ListView x:Name="logListView" DockPanel.Dock="Top" ItemsSource="{Binding LogItems}" MouseDoubleClick="LogListView_MouseDoubleClick" Margin="0"
                              ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView AllowsColumnReorder="False">
                                <GridViewColumn Header="Time" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=Datetime, StringFormat=\{0:G\}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Data" Width="800">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path=Message}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
