<UserControl x:Class="DS4WinWPF.DS4Forms.ControllerOverviewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="940">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <!-- Keep converters used by this control local. The dark theme also
             exposes this key, but a fresh install starts with DefaultTheme;
             relying on a theme-specific resource made the main window fail
             during first-run XAML construction. -->
        <xctk:InverseBoolConverter x:Key="InverseBoolConverter" />

        <Style x:Key="OverviewCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="OverviewEyebrowStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedForegroundColor}" />
        </Style>

        <Style x:Key="OverviewValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="OverviewSpeakerPanelStyle" TargetType="Grid">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsEnabled" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedControllerSupportsAudio}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="OverviewInsetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource RaisedBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="15" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="OverviewSettingsComboBoxStyle" TargetType="ComboBox"
               BasedOn="{StaticResource BridgeProfileComboBoxStyle}">
            <Setter Property="Width" Value="Auto" />
            <!-- The shared template is designed around 42 DIP. Compressing it
                 here clips the lower border/content at fractional DPI. -->
            <Setter Property="Height" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="OverviewQuickSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28" VerticalAlignment="Center">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="{DynamicResource AccentColor}"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Knob" Background="{DynamicResource ForegroundColor}"
                                                        BorderBrush="{DynamicResource AccentColor}"
                                                        BorderThickness="2" CornerRadius="9" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Knob" Property="BorderThickness" Value="3" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="{DynamicResource BorderColor}"
                                                        CornerRadius="3" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                            <TickBar x:Name="SliderTicks"
                                     Visibility="Collapsed"
                                     IsHitTestVisible="False"
                                     Margin="9,0,9,3"
                                     Height="5"
                                     VerticalAlignment="Bottom"
                                     Placement="Bottom"
                                     Fill="{DynamicResource MutedForegroundColor}"
                                     Minimum="{TemplateBinding Minimum}"
                                     Maximum="{TemplateBinding Maximum}"
                                     TickFrequency="{TemplateBinding TickFrequency}"
                                     Ticks="{TemplateBinding Ticks}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="TickPlacement" Value="BottomRight">
                                <Setter TargetName="SliderTicks" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverviewToggleStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ToggleTrack" Width="36" Height="20"
                                    HorizontalAlignment="Left" CornerRadius="10"
                                    Background="{DynamicResource BorderColor}">
                                <Ellipse x:Name="ToggleKnob" Width="14" Height="14" Margin="3"
                                         HorizontalAlignment="Left"
                                         Fill="{DynamicResource ForegroundColor}" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Background" Value="{DynamicResource AccentColor}" />
                                <Setter TargetName="ToggleKnob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleTrack" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="470" Padding="30">
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource OverviewCardStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasSelectedController}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center">
                <Border Width="54" Height="54" CornerRadius="27"
                        Background="{DynamicResource RaisedBackgroundColor}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                               Foreground="{DynamicResource AccentColor}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{lex:Loc Overview.NoControllerSelected}" Margin="0,16,0,5"
                           FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{lex:Loc Overview.NoControllerHint}"
                           Foreground="{DynamicResource MutedForegroundColor}" TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,8,6">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelectedController}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource OverviewCardStyle}" Padding="20" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="152" Height="92" CornerRadius="5" Margin="0,0,20,0"
                                Background="{DynamicResource RaisedBackgroundColor}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="7">
                            <Image Source="{Binding SelectedController.ControllerImageSource}"
                                   Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{lex:Loc Overview.SelectedControllerLabel}" Style="{StaticResource OverviewEyebrowStyle}" />
                            <TextBlock Text="{Binding SelectedController.ControllerDisplayName}"
                                       Margin="0,5,0,3" FontSize="22" FontWeight="SemiBold"
                                       Foreground="{DynamicResource ForegroundColor}" />
                            <TextBlock Text="{Binding SelectedController.IdText}"
                                       ToolTip="{Binding SelectedController.IdText}"
                                       Foreground="{DynamicResource MutedForegroundColor}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Background="{DynamicResource RaisedBackgroundColor}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{lex:Loc Overview.ProfileLabel}" Foreground="{DynamicResource MutedForegroundColor}" />
                                        <TextBlock Text="{Binding CurrentProfileName}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentColor}"
                                                   MaxWidth="190" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding CurrentProfileName}" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource RaisedBackgroundColor}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        CornerRadius="3" Padding="8,4">
                                    <TextBlock Text="{Binding SelectedControllerConnection}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0">
                            <TextBlock Text="{lex:Loc Overview.BatteryLabel}" Style="{StaticResource OverviewEyebrowStyle}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding SelectedControllerBattery}" Margin="0,5,0,0"
                                       FontSize="20" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SuccessColor}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <WrapPanel Grid.Row="1" Margin="-6,0,-6,8">
                    <Border Style="{StaticResource OverviewCardStyle}" Width="218" MinHeight="112" Margin="6">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Overview.ConnectionLabel}" Style="{StaticResource OverviewEyebrowStyle}" />
                            <TextBlock Text="{Binding SelectedControllerConnection}" Margin="0,11,0,3"
                                       Style="{StaticResource OverviewValueStyle}" />
                            <TextBlock Text="{lex:Loc Overview.ReportIntervalLabel}" Margin="0,5,0,2"
                                       FontSize="11"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                            <TextBlock Text="{Binding SelectedControllerLatency}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentColor}"
                                       TextWrapping="Wrap"
                                       ToolTip="{lex:Loc Overview.ReportIntervalTip}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OverviewCardStyle}" Width="218" MinHeight="112" Margin="6">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Overview.ActiveProfileLabel}" Style="{StaticResource OverviewEyebrowStyle}" />
                            <TextBlock Text="{Binding CurrentProfileName}" Margin="0,11,0,3"
                                       Style="{StaticResource OverviewValueStyle}" />
                             <TextBlock Text="{lex:Loc Overview.ActiveProfileHint}"
                                        TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OverviewCardStyle}" Width="218" MinHeight="112" Margin="6">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Overview.EmulatedDeviceLabel}" Style="{StaticResource OverviewEyebrowStyle}" />
                            <TextBlock Margin="0,11,0,3" Style="{StaticResource OverviewValueStyle}"
                                       Text="{Binding SelectedOutputControllerName}" />
                             <TextBlock Text="{lex:Loc Overview.EmulatedDeviceHint}"
                                        TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource OverviewCardStyle}" Width="218" MinHeight="112" Margin="6">
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Overview.ControllerStatusLabel}" Style="{StaticResource OverviewEyebrowStyle}" />
                            <TextBlock Text="{Binding SelectedControllerStartupTitle}"
                                       Margin="0,11,0,3">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource OverviewValueStyle}">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedControllerIsReady}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessColor}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedControllerNeedsAttention}" Value="True">
                                                <Setter Property="Foreground" Value="#FFFFB020" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                             <TextBlock Text="{Binding SelectedControllerStartupDetail}"
                                        TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <Border Grid.Row="2" Style="{StaticResource OverviewCardStyle}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{lex:Loc Overview.QuickProfileControlsTitle}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{lex:Loc Overview.QuickProfileControlsDesc}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="6*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Border Style="{StaticResource OverviewInsetCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{lex:Loc Overview.EmulatedControllerTitle}" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{lex:Loc Overview.EmulatedControllerDesc}"
                                                   Margin="0,3,0,11" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundColor}" />
                                        <ComboBox x:Name="outputControllerCombo"
                                                  ItemsSource="{Binding OutputControllerChoices}"
                                                  SelectedValuePath="Type"
                                                  SelectedValue="{Binding SelectedOutputController, Mode=OneWay}"
                                                  SelectionChanged="OutputControllerCombo_SelectionChanged"
                                                  DropDownOpened="OutputControllerCombo_DropDownOpened"
                                                  DropDownClosed="OutputControllerCombo_DropDownClosed"
                                                  PreviewKeyDown="OutputControllerCombo_PreviewKeyDown"
                                                  Style="{StaticResource OverviewSettingsComboBoxStyle}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{lex:Loc Overview.EmulatedControllerNote}"
                                                   Margin="0,7,0,0" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource MutedForegroundColor}" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OverviewInsetCardStyle}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding SelectedController.FeedbackControlLabel}"
                                                   FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding HapticStrengthPercent, StringFormat={}{0}%}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentColor}" />
                                        <Slider Grid.Row="1" Grid.ColumnSpan="2" Margin="0,11,0,0"
                                                Style="{StaticResource OverviewQuickSliderStyle}"
                                                Minimum="0" Maximum="100" TickFrequency="1"
                                                Value="{Binding HapticStrengthPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" />
                                    </Grid>
                                </Border>

                                <Border x:Name="managedSpeakerRouteCard" Style="{StaticResource OverviewInsetCardStyle}" Margin="0"
                                        Visibility="{Binding SelectedControllerSupportsAudio, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid Style="{StaticResource OverviewSpeakerPanelStyle}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding SelectedController.ControllerAudioHeader}"
                                                   FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding SelectedController.ControllerAudioDescription}"
                                                   Margin="0,3,0,13" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundColor}" />
                                        <StackPanel Grid.Row="2">
                                            <CheckBox Content="{lex:Loc Overview.StreamAudioToggle}"
                                                      Style="{StaticResource OverviewToggleStyle}"
                                                      IsChecked="{Binding SpeakerOutputEnabled, Mode=TwoWay}"
                                                      ToolTip="{lex:Loc Overview.StreamAudioTip}"
                                                      Margin="0,0,0,12" />
                                            <CheckBox Content="{lex:Loc Overview.HeadsetOnlyToggle}"
                                                      Style="{StaticResource OverviewToggleStyle}"
                                                      IsChecked="{Binding HeadsetOnlyAudio, Mode=TwoWay}"
                                                      IsEnabled="{Binding SpeakerOutputEnabled}"
                                                      ToolTip="{lex:Loc Overview.HeadsetOnlyTip}"
                                                      Margin="0,0,0,13" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3">
                                            <TextBlock Text="{lex:Loc Overview.AudioSourceLabel}" Margin="0,0,0,7" FontWeight="SemiBold"
                                                       ToolTip="{lex:Loc Overview.AudioSourceTip}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="controllerAudioSourceCombo"
                                                          ItemsSource="{Binding ControllerAudioSourceChoices}"
                                                          SelectedValuePath="EndpointId"
                                                          SelectedValue="{Binding ControllerAudioSourceId, Mode=OneWay}"
                                                          SelectionChanged="ControllerAudioSourceCombo_SelectionChanged"
                                                          DropDownOpened="ControllerAudioSourceCombo_DropDownOpened"
                                                          DropDownClosed="ControllerAudioSourceCombo_DropDownClosed"
                                                          PreviewKeyDown="ControllerAudioSourceCombo_PreviewKeyDown"
                                                          IsEnabled="{Binding AudioHapticsSpeakerOverrideActive, Converter={StaticResource InverseBoolConverter}}"
                                                          Style="{StaticResource OverviewSettingsComboBoxStyle}"
                                                          ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button x:Name="refreshControllerAudioSourcesButton"
                                                        Grid.Column="1"
                                                        Width="42" Height="42" Margin="8,0,0,0"
                                                        Content="&#xE72C;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="15"
                                                        ToolTip="{lex:Loc Overview.RefreshAudioSourcesTip}"
                                                        Click="RefreshControllerAudioSources_Click" />
                                            </Grid>
                                        </StackPanel>
                                        <Border Grid.Row="4" Margin="0,10,0,0" Padding="9,7"
                                                CornerRadius="4" Background="#26FFB020"
                                                BorderBrush="#80FFB020" BorderThickness="1"
                                                Visibility="{Binding AudioHapticsSpeakerOverrideActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{lex:Loc Overview.AudioHapticsOverrideNotice}"
                                                       TextWrapping="Wrap" FontSize="11" Foreground="#FFFFC45C" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border x:Name="nativeUsbHeadsetCard" Style="{StaticResource OverviewInsetCardStyle}"
                                        Visibility="{Binding SelectedControllerShowsUsbHeadsetHelp, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="{lex:Loc Overview.UsbHeadsetTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{lex:Loc Overview.UsbHeadsetStep1}" Margin="0,10,0,10" TextWrapping="Wrap" />
                                        <TextBlock Text="{lex:Loc Overview.UsbHeadsetStep2}" Margin="0,0,0,10" TextWrapping="Wrap" />
                                        <TextBlock Text="{lex:Loc Overview.UsbHeadsetNote}" Margin="0,0,0,12" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" />
                                        <Button Content="{lex:Loc Overview.OpenSoundSettingsBtn}" HorizontalAlignment="Left" Padding="10,6"
                                                Style="{StaticResource BridgeSecondaryButtonStyle}"
                                                Click="OpenWindowsSoundSettings_Click" ToolTip="{lex:Loc Overview.OpenSoundSettingsTip}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel x:Name="managedAudioLevelsPanel"
                                            Visibility="{Binding SelectedControllerSupportsAudio, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border Style="{StaticResource OverviewInsetCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{lex:Loc Overview.OutputLevelsTitle}" FontSize="15" FontWeight="SemiBold" />
                                        <Grid Margin="0,13,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{lex:Loc Overview.ControllerSpeakerLabel}"
                                                       IsEnabled="{Binding HeadsetOnlyAudio, Converter={StaticResource InverseBoolConverter}}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SpeakerVolumePercent, StringFormat={}{0}%}"
                                                       IsEnabled="{Binding HeadsetOnlyAudio, Converter={StaticResource InverseBoolConverter}}"
                                                       Foreground="{DynamicResource AccentColor}" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,14"
                                                    Style="{StaticResource OverviewQuickSliderStyle}"
                                                    Minimum="0" Maximum="100" TickFrequency="1"
                                                    IsEnabled="{Binding HeadsetOnlyAudio, Converter={StaticResource InverseBoolConverter}}"
                                                    Value="{Binding SpeakerVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" />
                                            <TextBlock Grid.Row="2" Text="{lex:Loc Overview.HeadsetAuxLabel}"
                                                       IsEnabled="{Binding HeadsetOnlyAudio}"
                                                       ToolTip="{lex:Loc Overview.HeadsetAuxTip}" />
                                            <TextBlock Grid.Row="2" Grid.Column="1"
                                                       Text="{Binding HeadphoneVolumePercent, StringFormat={}{0}%}"
                                                       IsEnabled="{Binding HeadsetOnlyAudio}"
                                                       Foreground="{DynamicResource AccentColor}" />
                                            <Slider Grid.Row="3" Grid.ColumnSpan="2" Margin="0,7,0,0"
                                                    Style="{StaticResource OverviewQuickSliderStyle}"
                                                    Minimum="0" Maximum="100" TickFrequency="1"
                                                    IsEnabled="{Binding HeadsetOnlyAudio}"
                                                    Value="{Binding HeadphoneVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OverviewInsetCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{lex:Loc Overview.SpeakerProcessingTitle}" FontSize="15" FontWeight="SemiBold" />
                                        <Grid Margin="0,12,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{lex:Loc Overview.DynamicRangeLabel}" VerticalAlignment="Center"
                                                       ToolTip="{lex:Loc Overview.DynamicRangeTip}" />
                                            <ComboBox Grid.Column="1"
                                                      Style="{StaticResource OverviewSettingsComboBoxStyle}"
                                                      SelectedIndex="{Binding SpeakerCompressionIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="{lex:Loc Overview.Off}" />
                                                <ComboBoxItem Content="{lex:Loc Overview.Balanced}" />
                                                <ComboBoxItem Content="{lex:Loc Overview.Strong}" />
                                            </ComboBox>
                                            <TextBlock Grid.Row="1" Text="{lex:Loc Overview.BassBodyLabel}" VerticalAlignment="Center"
                                                       Margin="0,13,0,0"
                                                       ToolTip="{lex:Loc Overview.BassBodyTip}" />
                                            <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,13,0,0">
                                                <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0"
                                                           MinWidth="34" TextAlignment="Right"
                                                           Text="{Binding SpeakerBassBoostDb, StringFormat={}{0} dB}" />
                                                <Slider Style="{StaticResource OverviewQuickSliderStyle}"
                                                        Minimum="0" Maximum="6" TickFrequency="1"
                                                        TickPlacement="BottomRight"
                                                        IsSnapToTickEnabled="True"
                                                        Value="{Binding SpeakerBassBoostDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" />
                                            </DockPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource OverviewInsetCardStyle}" Margin="0">
                                    <StackPanel>
                                        <TextBlock Text="{lex:Loc Overview.MicrophoneTitle}" FontSize="15" FontWeight="SemiBold" />
                                        <CheckBox Content="{Binding SelectedController.MicrophoneToggleLabel}"
                                                  Style="{StaticResource OverviewToggleStyle}"
                                                  IsChecked="{Binding MicrophoneInputEnabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding CanChangeMicrophoneInput}"
                                                  ToolTip="{Binding MicrophoneAvailabilityText}"
                                                  Margin="0,12,0,9" />
                                        <TextBlock Text="{Binding SelectedController.MicrophoneDescription}"
                                                   Margin="0,0,0,8" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundColor}" />
                                        <TextBlock Margin="0,0,0,9" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedForegroundColor}"
                                                   Text="{Binding MicrophoneAvailabilityText}"
                                                   Visibility="{Binding ShowMicrophoneAvailabilityMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Grid IsEnabled="{Binding MicrophoneLevelControlsEnabled}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{lex:Loc Overview.MicrophoneLevelLabel}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding MicrophoneVolumePercent, StringFormat={}{0}%}"
                                                       Foreground="{DynamicResource AccentColor}" />
                                            <Slider Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,12"
                                                    Style="{StaticResource OverviewQuickSliderStyle}"
                                                    Minimum="0" Maximum="100" TickFrequency="1"
                                                    Value="{Binding MicrophoneVolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=220}" />
                                        </Grid>
                                        <Grid IsEnabled="{Binding MicrophoneLevelControlsEnabled}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="3*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{lex:Loc Overview.NoiseSuppressionLabel}" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1"
                                                      Style="{StaticResource OverviewSettingsComboBoxStyle}"
                                                      SelectedIndex="{Binding MicrophoneNoiseSuppressionIndex, Mode=TwoWay}">
                                                <ComboBoxItem Content="{lex:Loc Overview.Off}" />
                                                <ComboBoxItem Content="{lex:Loc Overview.Balanced}" />
                                                <ComboBoxItem Content="{lex:Loc Overview.Strong}" />
                                                <ComboBoxItem Content="{lex:Loc Overview.NvidiaAI}"
                                                              IsEnabled="{Binding NvidiaNoiseSuppressionAvailable}"
                                                              ToolTip="{Binding NvidiaNoiseSuppressionAvailability}" />
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource OverviewCardStyle}">
                    <StackPanel>
                        <StackPanel>
                            <TextBlock Text="{lex:Loc Overview.QuickActionsTitle}" FontSize="18" FontWeight="SemiBold" />
                             <TextBlock Text="{lex:Loc Overview.QuickActionsDesc}"
                                        Margin="0,3,0,0" TextWrapping="Wrap"
                                        Foreground="{DynamicResource MutedForegroundColor}" />
                        </StackPanel>
                        <WrapPanel Margin="0,15,0,0">
                            <Button Content="{lex:Loc Overview.EditActiveProfileBtn}" Margin="0,0,8,0"
                                    Style="{StaticResource BridgePrimaryButtonStyle}"
                                    Click="EditProfileBtn_Click" />
                            <Button Content="{lex:Loc Overview.ControllerDetailsBtn}" Margin="0,0,8,0"
                                    Style="{StaticResource BridgeSecondaryButtonStyle}"
                                    Click="ControllerDetailsBtn_Click" />
                            <Button Content="{lex:Loc Overview.LightbarControlsBtn}" Margin="0,0,8,0"
                                    Style="{StaticResource BridgeSecondaryButtonStyle}"
                                    ToolTip="{lex:Loc Overview.LightbarControlsTip}"
                                    Click="LightbarBtn_Click" />
                            <Button Content="{lex:Loc Overview.DisconnectBtn}"
                                    Style="{StaticResource BridgeSecondaryButtonStyle}"
                                    IsEnabled="{Binding SelectedControllerIsWireless}"
                                    Click="DisconnectBtn_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
