<Window x:Class="DS4WinWPF.DS4Forms.ViiperDebuggerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VIIPER Debugger"
        Height="540"
        Width="820"
        MinHeight="430"
        MinWidth="700"
        Style="{DynamicResource WindowStyle}">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="VIIPER Debugger"
                       FontSize="16"
                       FontWeight="Bold"
                       Margin="0,0,0,4" />
            <TextBlock Text="Runs temporary virtual-controller probes and writes detailed diagnostics to the DS4Windows log. Tests create and dispose throwaway VIIPER devices."
                       TextWrapping="Wrap"
                       Opacity="0.78"
                       Margin="0,0,0,10" />

            <WrapPanel Margin="0,0,0,10">
                <Button x:Name="runAllBtn" Content="Run All" MinWidth="90" Margin="0,0,8,8" Click="RunAllBtn_Click" />
                <Button x:Name="prereqBtn" Content="Prerequisites" MinWidth="110" Margin="0,0,8,8" Click="PrereqBtn_Click" />
                <Button x:Name="xboxBtn" Content="Xbox 360" MinWidth="90" Margin="0,0,8,8" Click="XboxBtn_Click" />
                <Button x:Name="ds4Btn" Content="DS4" MinWidth="70" Margin="0,0,8,8" Click="Ds4Btn_Click" />
                <Button x:Name="dualSenseBtn" Content="DualSense" MinWidth="100" Margin="0,0,8,8" Click="DualSenseBtn_Click" />
                <Button x:Name="dualSenseEdgeBtn" Content="DualSense Edge" MinWidth="125" Margin="0,0,8,8" Click="DualSenseEdgeBtn_Click" />
                <Button x:Name="switch2Btn" Content="Switch 2" MinWidth="90" Margin="0,0,8,8" Click="Switch2Btn_Click" />
                <Button x:Name="adaptiveBtn" Content="Adaptive Triggers" MinWidth="135" Margin="0,0,8,8" Click="AdaptiveBtn_Click" />
                <Button x:Name="hapticsToneBtn" Content="Haptics Tone" MinWidth="115" Margin="0,0,8,8" Click="HapticsToneBtn_Click" />
                <Button x:Name="microphoneBtn" Content="Bluetooth Mic Probe" MinWidth="145" Margin="0,0,8,8" Click="MicrophoneBtn_Click" />
                <Button x:Name="startTrafficBtn" Content="Start DS Traffic Capture" MinWidth="165" Margin="0,0,8,8" Click="StartTrafficBtn_Click" />
                <Button x:Name="stopTrafficBtn" Content="Stop DS Traffic Capture" MinWidth="160" Margin="0,0,8,8" Click="StopTrafficBtn_Click" />
                <Button x:Name="dumpTrafficBtn" Content="Export DS Traffic" MinWidth="140" Margin="0,0,8,8" Click="DumpTrafficBtn_Click" />
                <Button x:Name="clearTrafficBtn" Content="Clear DS Traffic" MinWidth="130" Margin="0,0,8,8" Click="ClearTrafficBtn_Click" />
            </WrapPanel>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="statusText"
                       Text="Ready"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left" />
            <Button x:Name="closeBtn"
                    Content="Close"
                    Width="90"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="CloseBtn_Click" />
        </DockPanel>

        <TextBox x:Name="outputText"
                 FontFamily="Consolas"
                 FontSize="12"
                 TextWrapping="NoWrap"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" />
    </DockPanel>
</Window>
