                                    <StackPanel>
                                        <TextBlock Text="Startup" Style="{DynamicResource BridgeSectionTitleStyle}" />
                                        <TextBlock Text="Choose how DS4Windows opens when you sign in." Style="{DynamicResource BridgeSectionDescriptionStyle}" />
                                        <CheckBox x:Name="runAtStartCk" Content="{lex:Loc RunAtStartup}" Margin="{StaticResource spaceMargin}" IsEnabled="{Binding CanChangeStartupPreference}" IsChecked="{Binding RunAtStartup}" ToolTip="Open DS4Windows automatically when you sign in to Windows." Click="RunAtStartCk_Click" Style="{DynamicResource BridgeSettingsCheckBoxStyle}" />
                                        <TextBlock Text="{Binding StartupStatusText}" TextWrapping="Wrap" Visibility="{Binding StartupStatusVisibility}" MaxWidth="420" HorizontalAlignment="Left" Margin="{StaticResource spaceMargin}" />
                                        <GroupBox x:Name="runAsGroupBox" Header="{lex:Loc RunAs}" BorderThickness="0" Visibility="{Binding ShowRunStartPanel}" IsEnabled="{Binding CanChangeStartupMode}" Margin="24,0,0,14" Padding="0">
                                            <WrapPanel Margin="0,8,0,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Content="{lex:Loc Program}" GroupName="RunAsOpt" Margin="0,0,18,0" IsChecked="{Binding RunStartProg}" />
