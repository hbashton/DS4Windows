<Window x:Class="DS4Windows.Bootstrapper.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DS4Windows Setup" Width="760" Height="640" MinWidth="700" MinHeight="580"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Icon="DS4W.ico" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
  <Window.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#2F80ED" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4A94F5" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#32B67A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E7A83E" />
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="24,11" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="{StaticResource AccentHoverBrush}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Margin" Value="0,6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
  </Window.Resources>

  <Grid Margin="28,22,28,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="0,0,0,20">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="58" Height="58" CornerRadius="15" Background="#183E73">
        <Image Source="DS4W.ico" Width="42" Height="42" Stretch="Uniform" />
      </Border>
      <StackPanel Grid.Column="1" Margin="16,2,0,0">
        <TextBlock Text="DS4Windows" FontSize="25" FontWeight="SemiBold" />
        <TextBlock x:Name="HeaderSubtitle" Text="Standard x64 setup" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1">
      <Grid x:Name="DetectingPage">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="300" Height="5" Foreground="{StaticResource AccentBrush}" />
          <TextBlock Text="Checking this PC…" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0" />
          <TextBlock Text="DS4Windows, VIIPER, and USB-IP are being inspected." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" />
        </StackPanel>
      </Grid>

      <Grid x:Name="ConfirmationPage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock x:Name="ModeTitle" Text="Ready to install" FontSize="23" FontWeight="SemiBold" />
            <TextBlock x:Name="ModeDescription" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18" />

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Installation status" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,11" />
                <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="DS4Windows" FontWeight="SemiBold"/><TextBlock x:Name="Ds4Status" Grid.Column="1" Foreground="{StaticResource AccentBrush}"/></Grid>
                <Grid Margin="0,7,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="VIIPER 0.0.6" FontWeight="SemiBold"/><TextBlock x:Name="ViiperStatus" Grid.Column="1" Foreground="{StaticResource AccentBrush}"/></Grid>
                <Grid Margin="0,7,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="USB-IP 0.9.7.7" FontWeight="SemiBold"/><TextBlock x:Name="UsbipStatus" Grid.Column="1" Foreground="{StaticResource AccentBrush}"/></Grid>
              </StackPanel>
            </Border>

            <Border x:Name="OptionsCard" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Options" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7" />
                <CheckBox x:Name="DesktopShortcutCheckBox" IsChecked="True" Content="Create a desktop shortcut" />
                <CheckBox x:Name="HidHideCheckBox" IsChecked="True" Content="Install HidHide (recommended — prevents double input)" />
                <TextBlock Text="Optional system driver. Existing healthy installations are left unchanged." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="24,-2,0,5" />
                <CheckBox x:Name="FakerInputCheckBox" IsChecked="False" Content="Install FakerInput (virtual keyboard and mouse)" />
                <TextBlock Text="Useful for profiles that send keyboard or mouse input to elevated games." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="24,-2,0,0" />
              </StackPanel>
            </Border>

            <TextBlock Text="Installs to C:\Program Files\DS4Windows. Profiles, settings, logs, and user-created files are preserved during updates and repairs." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="0,20,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="CancelButton" Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="0,0,10,0" Click="Cancel_Click" />
          <Button x:Name="ActionButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Install" Click="Action_Click" />
        </Grid>
      </Grid>

      <Grid x:Name="ProgressPage" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="ProgressTitle" Text="Preparing installation…" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock x:Name="ProgressDetail" Text="Building a safe installation plan" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,26" />
          <ProgressBar x:Name="OverallProgress" Height="8" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}" Background="{DynamicResource BorderBrush}" />
          <TextBlock x:Name="ProgressPercent" Text="0%" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,7,0,0" />
          <Border Style="{StaticResource Card}" Margin="0,26,0,0">
            <TextBlock Text="DS4Windows Setup requests administrator permission once, closes only recognized DS4Windows and VIIPER processes, and will not replace a live USB driver across an unsafe reboot boundary." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
          </Border>
        </StackPanel>
      </Grid>

      <Grid x:Name="CompletePage" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
          <Border Width="64" Height="64" CornerRadius="32" Background="#2532B67A" HorizontalAlignment="Center"><TextBlock Text="✓" FontSize="34" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <TextBlock x:Name="CompleteTitle" Text="DS4Windows is ready" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,0" />
          <TextBlock x:Name="CompleteDescription" Text="Installation and verification completed successfully." TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,22" />
          <CheckBox x:Name="LaunchCheckBox" IsChecked="True" Content="Launch DS4Windows" HorizontalAlignment="Center" />
          <Button Style="{StaticResource PrimaryButton}" Content="Finish" Width="130" HorizontalAlignment="Center" Margin="0,20,0,0" Click="Finish_Click" />
        </StackPanel>
      </Grid>

      <Grid x:Name="RestartPage" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Restart required" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="USB-IP was installed or repaired safely. Restart Windows to activate the verified driver, then DS4Windows and VIIPER will start automatically." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="50,12,50,26" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource SecondaryButton}" Content="Restart later" Margin="0,0,10,0" Click="RestartLater_Click" />
            <Button Style="{StaticResource PrimaryButton}" Content="Restart now" Click="RestartNow_Click" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <Grid x:Name="FailurePage" Visibility="Collapsed">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Setup needs attention" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock x:Name="FailureMessage" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="50,12,50,24" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Style="{StaticResource SecondaryButton}" Content="Open log" Margin="0,0,10,0" Click="OpenLog_Click" />
            <Button Style="{StaticResource SecondaryButton}" Content="Copy diagnostics" Margin="0,0,10,0" Click="CopyDiagnostics_Click" />
            <Button Style="{StaticResource PrimaryButton}" Content="Retry" Click="Retry_Click" />
          </StackPanel>
          <Button Content="Close" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" Cursor="Hand" Margin="0,18,0,0" Click="Cancel_Click" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
