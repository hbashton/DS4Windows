                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label Content="{lex:Loc AppTheme}" ContentStringFormat="{}{0}:" VerticalAlignment="Center" Padding="0" Margin="0,0,16,0" />
                                            <ComboBox x:Name="appThemeCom" SelectedIndex="{Binding AppChoiceIndex,FallbackValue='0'}" Margin="0" Grid.Column="1" Width="220" Style="{DynamicResource BridgeSettingsComboBoxStyle}">
                                                <ComboBoxItem Content="{lex:Loc Default}" />
                                                <ComboBoxItem Content="{lex:Loc Light}" />
                                                <ComboBoxItem Content="{lex:Loc Dark}" />
                                            </ComboBox>
                                        </Grid>
                                        <Grid Margin="{StaticResource spaceMargin}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
