                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="clearSettingsSearchBtn" DockPanel.Dock="Right" Content="Clear" Visibility="Collapsed" Margin="8,0,0,0" Style="{DynamicResource BridgeSecondaryButtonStyle}" Click="ClearSettingsSearchBtn_Click" />
