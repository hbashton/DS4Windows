                                        <CheckBox x:Name="reclaimSteamInputCk" Content="Reclaim controller from Steam Input automatically" IsEnabled="{Binding SystemIntegrationEnabled}" Margin="{StaticResource spaceMargin}" IsChecked="{Binding ReclaimSteamInput}" Click="ReclaimSteamInputCk_Click" ToolTip="Release Steam Input's hold on the physical controller so DS4Windows can use it. Virtual controller output remains available to games." Style="{DynamicResource BridgeSettingsCheckBoxStyle}" />
