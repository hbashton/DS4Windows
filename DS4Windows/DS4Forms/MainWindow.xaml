                        <Grid>
                            <TextBox x:Name="settingsSearchTextBox" Style="{DynamicResource BridgeSearchTextBoxStyle}" AutomationProperties.Name="Search settings" ToolTip="Search all settings (Ctrl+F)" TextChanged="SettingsSearchTextBox_TextChanged" />
                            <TextBlock Text="Search settings…" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource MutedForegroundColor}">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=settingsSearchTextBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        </Border>
                    </DockPanel>
                    <TextBlock x:Name="settingsSearchStatus" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,12" Foreground="{DynamicResource MutedForegroundColor}" />
                    <Border x:Name="settingsNoResults" Grid.Row="3" Visibility="Collapsed" VerticalAlignment="Top" Style="{DynamicResource BridgeCardStyle}"><StackPanel><TextBlock Text="No matching settings" Style="{DynamicResource BridgeSectionTitleStyle}" /><TextBlock Text="Try a different term, such as startup, USB/IP or language, or clear the search." TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundColor}" /></StackPanel></Border>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,12" KeyboardNavigation.TabNavigation="Continue">
                        <RadioButton x:Name="settingsGeneralNav" Tag="General" Click="SettingsCategory_Checked" GroupName="SettingsCategory" Content="General" IsChecked="True" Style="{DynamicResource BridgeSettingsCategoryStyle}" Checked="SettingsCategory_Checked" />
                        <RadioButton x:Name="settingsAppearanceNav" Tag="Appearance" Click="SettingsCategory_Checked" GroupName="SettingsCategory" Content="Appearance" IsChecked="False" Style="{DynamicResource BridgeSettingsCategoryStyle}" Checked="SettingsCategory_Checked" />
                        <RadioButton x:Name="settingsControllersNav" Tag="Controllers" Click="SettingsCategory_Checked" GroupName="SettingsCategory" Content="Controllers" IsChecked="False" Style="{DynamicResource BridgeSettingsCategoryStyle}" Checked="SettingsCategory_Checked" />
                        <RadioButton x:Name="settingsToolsNav" Tag="Tools" Click="SettingsCategory_Checked" GroupName="SettingsCategory" Content="Updates &amp; tools" IsChecked="False" Style="{DynamicResource BridgeSettingsCategoryStyle}" Checked="SettingsCategory_Checked" />
