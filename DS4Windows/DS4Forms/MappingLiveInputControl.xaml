<UserControl x:Class="DS4WinWPF.DS4Forms.MappingLiveInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" Foreground="{DynamicResource ForegroundColor}">
    <Border Background="{DynamicResource RaisedBackgroundColor}"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
            CornerRadius="8" Padding="12,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Live input" FontWeight="SemiBold" FontSize="12" />
                    <TextBlock Text="Physical controller · before remapping" FontSize="10" Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedForegroundColor}" />
                </StackPanel>
                <TextBlock x:Name="liveStatus" Grid.Column="1" Text="Waiting" FontSize="10"
                           Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
            <Grid Grid.Row="1" Margin="0,9,0,8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Canvas x:Name="leftStickPlot" Width="48" Height="48">
                        <Ellipse Width="48" Height="48" Fill="{DynamicResource BackgroundColor}" Stroke="{DynamicResource BorderColor}" />
                        <Line X1="24" Y1="3" X2="24" Y2="45" Stroke="{DynamicResource BorderColor}" />
                        <Line X1="3" Y1="24" X2="45" Y2="24" Stroke="{DynamicResource BorderColor}" />
                        <Ellipse x:Name="leftStickDot" Width="8" Height="8" Canvas.Left="20" Canvas.Top="20" Fill="{DynamicResource AccentColor}" />
                    </Canvas>
                    <StackPanel Margin="7,0,5,0" VerticalAlignment="Center">
                        <TextBlock Text="L stick" FontWeight="SemiBold" FontSize="10" />
                        <TextBlock x:Name="leftStickValue" Text="X —&#x0a;Y —" FontSize="10" Margin="0,3,0,0"
                                   Foreground="{DynamicResource MutedForegroundColor}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Canvas x:Name="rightStickPlot" Width="48" Height="48">
                        <Ellipse Width="48" Height="48" Fill="{DynamicResource BackgroundColor}" Stroke="{DynamicResource BorderColor}" />
                        <Line X1="24" Y1="3" X2="24" Y2="45" Stroke="{DynamicResource BorderColor}" />
                        <Line X1="3" Y1="24" X2="45" Y2="24" Stroke="{DynamicResource BorderColor}" />
                        <Ellipse x:Name="rightStickDot" Width="8" Height="8" Canvas.Left="20" Canvas.Top="20" Fill="{DynamicResource AccentColor}" />
                    </Canvas>
                    <StackPanel Margin="7,0,5,0" VerticalAlignment="Center">
                        <TextBlock Text="R stick" FontWeight="SemiBold" FontSize="10" />
                        <TextBlock x:Name="rightStickValue" Text="X —&#x0a;Y —" FontSize="10" Margin="0,3,0,0"
                                   Foreground="{DynamicResource MutedForegroundColor}" />
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="23" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="24" /></Grid.RowDefinitions>
                    <TextBlock x:Name="leftTriggerName" Text="L2" FontSize="10" VerticalAlignment="Center" />
                    <ProgressBar x:Name="leftTriggerMeter" Grid.Column="1" Minimum="0" Maximum="100" Height="7"
                                 Foreground="{DynamicResource AccentColor}" Background="{DynamicResource BorderColor}" BorderThickness="0" />
                    <TextBlock x:Name="leftTriggerValue" Grid.Column="2" Text="—" HorizontalAlignment="Right" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock x:Name="rightTriggerName" Grid.Row="1" Text="R2" FontSize="10" VerticalAlignment="Center" />
                    <ProgressBar x:Name="rightTriggerMeter" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Height="7"
                                 Foreground="{DynamicResource AccentColor}" Background="{DynamicResource BorderColor}" BorderThickness="0" />
                    <TextBlock x:Name="rightTriggerValue" Grid.Row="1" Grid.Column="2" Text="—" HorizontalAlignment="Right" FontSize="10" VerticalAlignment="Center" />
                </Grid>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="PRESSED" FontSize="9" FontWeight="SemiBold" Margin="0,0,10,0"
                           Foreground="{DynamicResource MutedForegroundColor}" VerticalAlignment="Center" />
                <TextBlock x:Name="pressedButtons" Grid.Column="1" Text="Connect a controller, then reopen this editor."
                           FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentColor}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
