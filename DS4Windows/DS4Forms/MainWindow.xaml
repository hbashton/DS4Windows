                                        </GroupBox>
                                        <CheckBox Content="{lex:Loc StartMinimized}" Margin="{StaticResource spaceMargin}" IsChecked="{Binding StartMinimize}" ToolTip="Open DS4Windows quietly without showing the main window." Style="{DynamicResource BridgeSettingsCheckBoxStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{DynamicResource BridgeCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Window behavior" Style="{DynamicResource BridgeSectionTitleStyle}" />
