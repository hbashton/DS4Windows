<Window x:Name="mainDS4Window" x:Class="DS4WinWPF.DS4Forms.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:lex="http://wpflocalizeextension.codeplex.com"
        lex:LocalizeDictionary.DesignCulture=""
        lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
        lex:ResxLocalizationProvider.DefaultDictionary="Strings"
        xmlns:local="clr-namespace:DS4WinWPF.DS4Forms"
        xmlns:localConverters="clr-namespace:DS4WinWPF.DS4Forms.Converters"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xml:lang="en-US"
        mc:Ignorable="d"
        Title="DS4Windows" Height="760" Width="1180" Closing="MainDS4Window_Closing" Closed="MainDS4Window_Closed" StateChanged="MainDS4Window_StateChanged" SizeChanged="MainDS4Window_SizeChanged" LocationChanged="MainDS4Window_LocationChanged" MinWidth="940" MinHeight="620"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Style="{DynamicResource WindowStyle}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:ImageLocationPaths x:Key="ImgLocPaths" />
        <localConverters:TrayIconConverter x:Key="TrayIconConverter" />
    </Window.Resources>
    <DockPanel>
        <tb:TaskbarIcon x:Name="notifyIcon" Icon="{Binding IconSource,Mode=OneWay,Converter={StaticResource TrayIconConverter}}" ToolTipText="{Binding TooltipText,Mode=OneWay}" MenuActivation="RightClick" TrayRightMouseUp="NotifyIcon_TrayRightMouseUp" TrayMiddleMouseDown="NotifyIcon_TrayMiddleMouseDown" TrayMouseDoubleClick="NotifyIcon_TrayMouseDoubleClick">
            <!--<tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open" />
                    <Separator />
                    <MenuItem x:Name="exitMenuItem" Header="Exit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>-->
        </tb:TaskbarIcon>

        <StackPanel DockPanel.Dock="Bottom" Height="38" VerticalAlignment="Bottom" Background="{DynamicResource SidebarBackgroundColor}">
            <DockPanel Height="38" Margin="10,0,10,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="aboutBtn" BorderThickness="0" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="#FF3881D8"
                            Style="{StaticResource NoBGHoverBtn}" Click="AboutBtn_Click">
                        <TextBlock Text="{lex:Loc HotkeysAbout}" TextDecorations="Underline" Foreground="{DynamicResource AccentColor}" Cursor="Hand" x:Uid="hotkeysText" />
                    </Button>
                    <Button x:Name="StartStopBtn" Content="{lex:Loc StartText}" Margin="10,0,4,0" Click="StartStopBtn_Click" MinWidth="76" Height="28" Foreground="White" Style="{StaticResource BridgePrimaryButtonStyle}" Padding="12,2" />
                </StackPanel>
                <Label x:Name="lastMsgLb" Content="{Binding Message}" ToolTip="{Binding Message}" Foreground="{Binding Color}" Margin="4,0,2,0" />
            </DockPanel>
        </StackPanel>
        <TabControl x:Name="mainTabCon" DockPanel.Dock="Top" SelectionChanged="MainTabCon_SelectionChanged" Style="{StaticResource BridgeMainTabControlStyle}">
            <TabItem x:Name="overviewTab" Header="Overview" Tag="&#xE80F;" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <local:ControllerOverviewControl x:Name="controllerOverviewControl"
                                                 EditProfileRequested="ControllerOverview_EditProfileRequested"
                                                 ControllerDetailsRequested="ControllerOverview_ControllerDetailsRequested"
                                                 LightbarRequested="ControllerOverview_LightbarRequested"
                                                 DisconnectRequested="ControllerOverview_DisconnectRequested" />
            </TabItem>

            <TabItem x:Name="controllersTab" Header="{lex:Loc Controllers}" Tag="&#xE7FC;" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label x:Name="noContLb" Grid.Row="0" Visibility="Hidden" Content="{lex:Loc NoControllersConnected}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <ListView x:Name="controllerLV" Grid.Row="0" ItemsSource="{Binding ControllerCol}" SelectionMode="Single"
                              SelectedIndex="{Binding CurrentIndex, Mode=OneWayToSource}" Margin="0"
                              SelectedItem="{Binding DataContext.SelectedController, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay}"
                              ItemContainerStyle="{StaticResource BridgeControllerCardItemStyle}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="116" Height="72" Margin="0,0,14,0" CornerRadius="5"
                                                Background="{DynamicResource CardBackgroundColor}"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Padding="5"
                                                Visibility="{Binding HasControllerArtwork, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Image Source="{Binding ControllerImageSource}" Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="idColumnTxtB" Text="{Binding IdText, Mode=OneWay}"
                                                       ToolTipOpening="IdColumnTxtB_ToolTipOpening" Tag="{Binding DevIndex, Mode=OneTime}"
                                                       FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <TextBlock.ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding IdText}" MaxWidth="450" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding TooltipIDText, Mode=OneWay}" />
                                                    </StackPanel>
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Image x:Name="contStatusImg" Source="{Binding StatusSource}" Stretch="Uniform"
                                                       Width="18" Height="18" Margin="0,0,6,0"
                                                       ToolTip="Right click to disconnect wireless"
                                                       MouseRightButtonUp="ContStatusImg_MouseRightButtonUp" Tag="{Binding DevIndex}" />
                                                <Image Source="{Binding ExclusiveSource}" Width="13" Height="13" Margin="0,0,5,0"
                                                       ToolTip="{Binding IsExclusiveText}" />
                                                <TextBlock Text="{Binding IsExclusiveText}" FontSize="11"
                                                           Foreground="{DynamicResource MutedForegroundColor}" />
                                            </StackPanel>
                                            <Button x:Name="joyConCardLinkButton" HorizontalAlignment="Left"
                                                    Margin="0,7,0,0" MinWidth="100" Height="32" Padding="10,3"
                                                    Visibility="{Binding JoyConLinkAction.Visible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    IsEnabled="{Binding JoyConLinkAction.Enabled}"
                                                    ToolTip="{Binding JoyConLinkAction.ToolTip}" ToolTipService.ShowOnDisabled="True"
                                                    Click="Switch2JoyConCardLinkBtn_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="9" Height="18" CornerRadius="4,1,1,4"
                                                            BorderBrush="{DynamicResource ForegroundColor}" BorderThickness="1.5" />
                                                    <TextBlock Text="ϟ" Foreground="{DynamicResource AccentColor}" Margin="2,0" />
                                                    <Border Width="9" Height="18" CornerRadius="1,4,4,1"
                                                            BorderBrush="{DynamicResource ForegroundColor}" BorderThickness="1.5" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding JoyConLinkAction.Text}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding JoyConLinkAction.IsArmed}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundColor}"
                                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                            CornerRadius="3" Padding="10,5" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Battery " Foreground="{DynamicResource MutedForegroundColor}" />
                                            <TextBlock Text="{Binding BatteryState, Mode=OneWay}" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SuccessColor}" />
                                        </StackPanel>
                                    </Border>

                                    <Separator Grid.Row="1" Grid.ColumnSpan="2" Margin="0,15,0,14"
                                               Background="{DynamicResource BorderColor}" />

                                    <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ACTIVE PROFILE" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,5" />
                                        <ComboBox Grid.Row="1" VerticalAlignment="Center" x:Name="selectProfCombo" Style="{StaticResource BridgeProfileComboBoxStyle}"
                                                      HorizontalAlignment="Left"
                                                      ItemsSource="{Binding ProfileListCol}" SelectedIndex="{Binding SelectedIndex}"
                                                      Tag="{Binding DevIndex, Mode=OneTime}"
                                                      Visibility="{Binding PrimaryDevice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                      SelectionChanged="SelectProfCombo_SelectionChanged" KeyDown="SelectProfCombo_KeyDown">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name,Mode=OneWay,FallbackValue=''}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <CheckBox Grid.Row="1" Grid.Column="1" Content="{lex:Loc LinkProfileId}" IsChecked="{Binding LinkedProfile}"
                                                  IsEnabled="{Binding CanLinkProfile}" Margin="12,0,12,0" VerticalAlignment="Center"
                                                  ToolTip="Use the same profile whenever this physical controller reconnects." />
                                        <xctk:SplitButton Grid.Row="1" Grid.Column="2" x:Name="ProfEditSBtn" Content="{lex:Loc Edit}"
                                                          MinWidth="84" Height="34" Margin="0,0,10,0"
                                                          Visibility="{Binding PrimaryDevice, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                          Tag="{Binding DevIndex, Mode=OneTime}" Click="ProfEditSBtn_Click" VerticalAlignment="Center">
                                            <xctk:SplitButton.DropDownContent>
                                                <Button x:Name="newProfBtn" Content="{lex:Loc NewProfile}" MinWidth="140"
                                                        Tag="{Binding DevIndex, Mode=OneTime}" Click="NewProfBtn_Click" />
                                            </xctk:SplitButton.DropDownContent>
                                        </xctk:SplitButton>
                                        <TextBlock Grid.Column="3" Visibility="{Binding SupportsSwitch2StandaloneHoldMode, Converter={StaticResource BooleanToVisibilityConverter}}" Text="JOY-CON HOLD" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,5" />
                                        <Button Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0"
                                                    Visibility="{Binding SupportsSwitch2StandaloneHoldMode, Converter={StaticResource BooleanToVisibilityConverter}}" Width="116" Height="34"
                                                    Content="{Binding Switch2StandaloneHoldModeText, Mode=OneWay}"
                                                    Click="Switch2JoyConHoldModeBtn_Click"
                                                    ToolTip="{Binding Switch2StandaloneHoldModeToolTip}" />
                                        <TextBlock Grid.Column="4" Visibility="{Binding SupportsSwitch2Identification, Converter={StaticResource BooleanToVisibilityConverter}}" Text="IDENTIFY" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,5" />
                                        <Button Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0"
                                                    Visibility="{Binding SupportsSwitch2Identification, Converter={StaticResource BooleanToVisibilityConverter}}" Width="92" Height="34"
                                                    Content="Ping"
                                                    Click="Switch2IdentifyBtn_Click"
                                                    ToolTip="Vibrate this controller so you can tell which one it is." />
                                        <TextBlock Grid.Column="5" Text="LIGHTBAR" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource MutedForegroundColor}" Margin="0,0,0,5" />
                                        <Button Grid.Row="1" Grid.Column="5" VerticalAlignment="Center" x:Name="LightColorBtn" Width="116" Height="34"
                                                    Background="{Binding LightColor, Mode=OneWay}" BorderBrush="{DynamicResource BorderColor}"
                                                    Tag="{Binding DevIndex, Mode=OneTime}" Click="LightColorBtn_Click"
                                                    ToolTip="Choose a temporary lightbar color" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Border x:Name="switch2JoyConManualPanel" Grid.Row="1"
                            Visibility="Collapsed" Margin="0,12,0,0"
                            Padding="14,12" CornerRadius="5"
                            Background="{DynamicResource CardBackgroundColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="UNMATCHED JOY-CON 2" FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource MutedForegroundColor}" />
                            <TextBlock x:Name="switch2JoyConManualStatusText"
                                       Text="Click Link on one Joy-Con, then Link on the other. The first controller keeps its profile and virtual pad."
                                       Margin="0,4,0,10" TextWrapping="Wrap" />
                            <ItemsControl x:Name="switch2JoyConManualRows">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="candidateCard" MinWidth="230"
                                                Margin="0,0,10,6" Padding="10,8"
                                                CornerRadius="4"
                                                Background="{DynamicResource CardBackgroundColor}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Margin="0,2,8,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource MutedForegroundColor}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Width="114" Height="36"
                                                        Padding="5" Click="Switch2JoyConManualPairBtn_Click"
                                                        ToolTip="{Binding PairButtonToolTip}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="13" Height="25" CornerRadius="6,2,2,6"
                                                                BorderBrush="{DynamicResource ForegroundColor}"
                                                                BorderThickness="1.5" />
                                                        <TextBlock Grid.Column="1" Text="ϟ" FontSize="18"
                                                                   Margin="3,0" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource AccentColor}" />
                                                        <Border Grid.Column="2" Width="13" Height="25"
                                                                CornerRadius="2,6,6,2"
                                                                BorderBrush="{DynamicResource ForegroundColor}"
                                                                BorderThickness="1.5" />
                                                        <TextBlock Grid.Column="3" Text="{Binding ButtonText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </Grid>
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsArmed}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="audioHapticsTab" Header="Audio Haptics" Tag="&#xE767;" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <local:AudioHapticsControl x:Name="audioHapticsControl" SettingsChanged="ProfileFeatureControl_SettingsChanged" />
            </TabItem>

            <TabItem x:Name="triggerLabTab" Header="Trigger Lab" Tag="TriggerPair" IsEnabled="{Binding FullTabsEnabled,Mode=OneWay}">
                <local:TriggerLabControl x:Name="triggerLabControl" SettingsChanged="ProfileFeatureControl_SettingsChanged" />
            </TabItem>

            <TabItem x:Name="profilesTab" Header="{lex:Loc Profiles}" Tag="&#xE8A5;">
                <Grid x:Name="profDockPanel">
                    <Grid x:Name="profilesBrowserPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="profOptsToolbar" Style="{StaticResource BridgeCardStyle}"
                                Padding="12,10" Margin="0,0,0,14">
                            <WrapPanel VerticalAlignment="Center">
                                <Button x:Name="newProfListBtn" Click="NewProfListBtn_Click"
                                        Style="{StaticResource BridgePrimaryButtonStyle}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding NewProfile, Source={StaticResource ImgLocPaths}}"
                                               Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="New profile" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="editProfBtn" IsEnabled="False" Click="EditProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding EditProfile, Source={StaticResource ImgLocPaths}}"
                                               Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="{lex:Loc Edit}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="dupProfBtn" IsEnabled="False" Click="DupProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding DuplicateProfile, Source={StaticResource ImgLocPaths}}"
                                               Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="{lex:Loc Duplicate}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="renameProfBtn" IsEnabled="False" Click="RenameProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding EditProfile, Source={StaticResource ImgLocPaths}}"
                                               Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="{lex:Loc RenameProfile}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="deleteProfBtn" IsEnabled="False" Click="DeleteProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Foreground="{DynamicResource DangerColor}"
                                        Margin="0,0,16,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding DeleteProfile, Source={StaticResource ImgLocPaths}}"
                                               Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="{lex:Loc Delete}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="importProfBtn" Click="ImportProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Margin="0,0,8,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding ImportProfile, Source={StaticResource ImgLocPaths}}"
                                               Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="{lex:Loc Import}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="exportProfBtn" IsEnabled="False" Click="ExportProfBtn_Click"
                                        Style="{StaticResource BridgeSecondaryButtonStyle}" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding ExportProfile, Source={StaticResource ImgLocPaths}}"
                                               Width="16" Height="16" Margin="0,0,7,0" />
                                        <TextBlock Text="{lex:Loc Export}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Border>

                        <Border x:Name="dupBoxBar" Grid.Row="1" Style="{StaticResource BridgeCardStyle}"
                                Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                            <local:DupBox x:Name="dupBox" HorizontalAlignment="Center" />
                        </Border>

                        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundColor}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Padding="18,14" BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Your profiles" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="Select a profile for actions, or double-click a card to edit it."
                                                       Margin="0,3,0,0" FontSize="11"
                                                       Foreground="{DynamicResource MutedForegroundColor}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundColor}"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                CornerRadius="4" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ElementName=profilesListBox, Path=Items.Count, StringFormat={}{0} profiles}"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MutedForegroundColor}" />
                                        </Border>
                                        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                                Width="340" MaxWidth="340" HorizontalAlignment="Left"
                                                Background="{DynamicResource CardBackgroundColor}"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons"
                                                           Foreground="{DynamicResource MutedForegroundColor}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBox x:Name="profilesSearchTextBox" Grid.Column="1"
                                                         Style="{DynamicResource BridgeSearchTextBoxStyle}"
                                                         TextChanged="ProfilesSearchTextBox_TextChanged"
                                                         ToolTip="Search profiles by name" />
                                                <Button x:Name="clearProfilesSearchBtn" Grid.Column="2" Content="&#xE711;"
                                                        FontFamily="Segoe Fluent Icons" FontSize="11"
                                                        Background="Transparent" BorderThickness="0"
                                                        Visibility="Collapsed" ToolTip="Clear search"
                                                        Click="ClearProfilesSearchBtn_Click" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="1">
                                    <ListBox x:Name="profilesListBox" Background="Transparent" BorderThickness="0"
                                             Padding="10" SelectionChanged="ProfilesListBox_SelectionChanged"
                                             MouseDoubleClick="ProfilesListBox_MouseDoubleClick"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.Resources>
                                            <localConverters:EscapeAccessKeysConverter x:Key="escapeAccessConvert" />
                                        </ListBox.Resources>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel IsItemsHost="True" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Width" Value="270" />
                                                <Setter Property="Height" Value="88" />
                                                <Setter Property="Margin" Value="6" />
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="ProfileCard" Background="{DynamicResource CardBackgroundColor}"
                                                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                                    CornerRadius="5" Padding="13">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
