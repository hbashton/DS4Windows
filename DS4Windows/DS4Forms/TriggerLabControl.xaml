<UserControl x:Class="DS4WinWPF.DS4Forms.TriggerLabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:ResxLocalizationProvider.DefaultAssembly="DS4Windows"
             lex:ResxLocalizationProvider.DefaultDictionary="Strings"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="960"
             HorizontalAlignment="Left" VerticalAlignment="Stretch"
             Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource ShellViewportWidth}, ConverterParameter=318}">
    <UserControl.Resources>
        <Style x:Key="LabCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="LabToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="42" Height="23">
                            <Border x:Name="Track" Background="{DynamicResource BorderColor}" CornerRadius="12" />
                            <Ellipse x:Name="Knob" Width="17" Height="17" Margin="3" HorizontalAlignment="Left" Fill="{DynamicResource ForegroundColor}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentColor}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LabModeButton" TargetType="Button" BasedOn="{StaticResource BridgeSecondaryButtonStyle}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style x:Key="LabSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/><Setter Property="TickFrequency" Value="5"/><Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="Height" Value="28"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="triggerLabScroll" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Grid Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border x:Name="overrideBadge" Margin="0,0,14,0" Padding="9,4" CornerRadius="4" Background="#4DFFB020" Visibility="Collapsed">
                        <TextBlock Text="{lex:Loc TriggerLab.OverrideBadge}" Foreground="#FFFFB020" FontSize="10" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{lex:Loc TriggerLab.EffectDesign}" Foreground="{DynamicResource MutedForegroundColor}"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button x:Name="linkedButton" Content="{lex:Loc TriggerLab.Linked}" MinWidth="76" Height="36" Margin="0,0,6,0"
                            Click="LinkedButton_Click" ToolTipService.ShowDuration="15000"
                            ToolTip="{lex:Loc TriggerLab.LinkedTip}" />
                    <Button x:Name="splitButton" Content="{lex:Loc TriggerLab.Split}" MinWidth="76" Height="36" Margin="0,0,14,0"
                            Click="SplitButton_Click" ToolTipService.ShowDuration="15000"
                            ToolTip="{lex:Loc TriggerLab.SplitTip}" />
                    <TextBlock Text="{lex:Loc TriggerLab.Enabled}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,9,0" />
                    <CheckBox x:Name="labEnabledToggle" Style="{StaticResource LabToggle}" Click="LabEnabledToggle_Click" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*" MinWidth="260"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource LabCard}"><ContentControl x:Name="leftCard" /></Border>
                <Border Grid.Column="2" Style="{StaticResource LabCard}"><ContentControl x:Name="rightCard" /></Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource LabCard}" Padding="14" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentColor}" VerticalAlignment="Center" />
                    <TextBlock x:Name="labStatusText" Grid.Column="1" Margin="10,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBlock x:Name="labBehaviorText" Grid.Column="2" Text="{lex:Loc TriggerLab.BehaviorNote}" Foreground="{DynamicResource MutedForegroundColor}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
