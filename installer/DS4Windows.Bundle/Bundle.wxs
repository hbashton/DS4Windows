<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Bundle
      Name="DS4Windows"
      Manufacturer="DS4Windows"
      Version="$(var.BundleVersion)"
      UpgradeCode="BC70CCB1-AD65-42A0-B468-8A7278A37A62"
      Tag="DS4WindowsManagedV2"
      IconSourceFile="$(var.ExtrasRoot)\..\DS4Windows\DS4W.ico"
      Compressed="yes"
      AboutUrl="https://github.com/hbashton/DS4Windows"
      HelpUrl="https://github.com/hbashton/DS4Windows/issues">

    <BootstrapperApplication SourceFile="$(var.BootstrapperRoot)\DS4Windows.Bootstrapper.exe" />

    <Variable Name="CreateDesktopShortcut" Type="numeric" Value="1" />
    <Variable Name="InstallHidHide" Type="numeric" Value="1" />
    <Variable Name="InstallFakerInput" Type="numeric" Value="0" />
    <Variable Name="SetupCorrelationId" Type="string" Value="" Persisted="yes" />
    <Variable Name="TargetUserSid" Type="string" Value="" Persisted="yes" />
    <Variable Name="TargetUserName" Type="string" Value="" Persisted="yes" />
    <Variable Name="TargetLocalAppData" Type="string" Value="" Persisted="yes" />
    <Variable Name="TargetRoamingAppData" Type="string" Value="" Persisted="yes" />

    <util:RegistrySearch
        Id="HidHideSearch"
        Variable="HidHideInstalled"
        Root="HKLM"
        Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\{01E0AB21-D1CC-42B4-9DFF-84FFE4F26DAF}"
        Value="DisplayVersion"
        Result="value"
        Bitness="always64" />

    <!-- Burn's restore-point creation can block indefinitely when Windows
         System Protection/WMI is unhealthy. MSI rollback already protects the
         application transaction, and the driver helper owns its own guarded
         rollback/reboot contract, so never hold the elevated engine here. -->
    <Chain DisableSystemRestore="yes">
      <!-- This package is first so Burn executes it last while unwinding a
           direct uninstall, after MSI has removed every owned file. It only
           removes empty directories and therefore preserves any unrecognized
           user or third-party content left under the install root. -->
      <ExePackage
          Id="PostUninstallCleanup"
          CacheId="DS4WindowsSetupActionsPostUninstall-$(var.SetupActionsHash)"
          Name="DS4Windows.SetupActions.PostUninstall.exe"
          SourceFile="$(var.SetupActionsPath)"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          DetectCondition="0"
          InstallArguments="postuninstall --correlation-id &quot;[SetupCorrelationId]&quot; --install-root &quot;[ProgramFiles64Folder]DS4Windows&quot;">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <ExePackage
          Id="CloseRunningApplications"
          CacheId="DS4WindowsSetupActionsPreflight-$(var.SetupActionsHash)"
          Name="DS4Windows.SetupActions.Preflight.exe"
          SourceFile="$(var.SetupActionsPath)"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          DetectCondition="0"
          InstallArguments="native-preflight --correlation-id &quot;[SetupCorrelationId]&quot;">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <MsiPackage
          Id="DS4WindowsMsi"
          SourceFile="$(var.MsiPath)"
          Visible="no"
          Vital="yes" />

      <ExePackage
          Id="HidHide"
          SourceFile="$(var.ExtrasRoot)\HidHide_1.5.230_x64.exe"
          PerMachine="yes"
          Permanent="yes"
          Vital="no"
          DetectCondition="HidHideInstalled"
          InstallCondition="InstallHidHide"
          InstallArguments="/quiet /norestart">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <MsiPackage
          Id="FakerInput"
          SourceFile="$(var.ExtrasRoot)\FakerInput_0.1.0_x64.msi"
          Permanent="yes"
          Vital="no"
          InstallCondition="InstallFakerInput"
          Visible="no" />

      <!-- This is the last fallible forward mutation. VIIPER owns the driver,
           broker-service, legacy-migration, authenticated health, and rollback
           transaction. Permanent prevents Burn from tearing down shared native
           state during an unrelated later rollback or outgoing upgrade. -->
      <ExePackage
          Id="NativeViiperInstallRepair"
          CacheId="DS4WindowsNativeViiperInstall-$(var.NativeActionCacheId)"
          Name="DS4Windows.SetupActions.NativeViiperInstall.exe"
          SourceFile="$(var.SetupActionsPath)"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          DetectCondition="0"
          InstallArguments="native-install --correlation-id &quot;[SetupCorrelationId]&quot; --install-root &quot;[ProgramFiles64Folder]DS4Windows&quot; --native-bundle-root &quot;[WixBundleExecutePackageCacheFolder]viiper-native-udecx&quot; --native-lock-path &quot;[WixBundleExecutePackageCacheFolder]viiper-native-udecx.lock.json&quot; --desktop-shortcut &quot;[CreateDesktopShortcut]&quot; --target-user-sid &quot;[TargetUserSid]&quot; --target-user-name &quot;[TargetUserName]&quot; --target-local-appdata &quot;[TargetLocalAppData]&quot; --target-roaming-appdata &quot;[TargetRoamingAppData]&quot;"
          RepairArguments="native-repair --correlation-id &quot;[SetupCorrelationId]&quot; --install-root &quot;[ProgramFiles64Folder]DS4Windows&quot; --native-bundle-root &quot;[WixBundleExecutePackageCacheFolder]viiper-native-udecx&quot; --native-lock-path &quot;[WixBundleExecutePackageCacheFolder]viiper-native-udecx.lock.json&quot; --desktop-shortcut &quot;[CreateDesktopShortcut]&quot; --target-user-sid &quot;[TargetUserSid]&quot; --target-user-name &quot;[TargetUserName]&quot; --target-local-appdata &quot;[TargetLocalAppData]&quot; --target-roaming-appdata &quot;[TargetRoamingAppData]&quot;">
        <PayloadGroupRef Id="NativeViiperRuntimePayloads" />
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <!-- Direct removal is a distinct always-absent permanent action. The BA
           plans it only for a top-level uninstall, so an outgoing related
           bundle cannot remove the incoming package. Burn executes it before
           MSI removal while the exact cached helper/media still exist. -->
      <ExePackage
          Id="NativeViiperUninstallForDirectRemove"
          CacheId="DS4WindowsNativeViiperRemove-$(var.NativeActionCacheId)"
          Name="DS4Windows.SetupActions.NativeViiperRemove.exe"
          SourceFile="$(var.SetupActionsPath)"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          DetectCondition="0"
          InstallArguments="native-uninstall --correlation-id &quot;[SetupCorrelationId]&quot; --native-bundle-root &quot;[WixBundleExecutePackageCacheFolder]viiper-native-udecx&quot; --native-lock-path &quot;[WixBundleExecutePackageCacheFolder]viiper-native-udecx.lock.json&quot; --target-user-sid &quot;[TargetUserSid]&quot; --target-user-name &quot;[TargetUserName]&quot; --target-local-appdata &quot;[TargetLocalAppData]&quot; --target-roaming-appdata &quot;[TargetRoamingAppData]&quot;">
        <PayloadGroupRef Id="NativeViiperRuntimePayloads" />
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
        <ExitCode Behavior="error" />
      </ExePackage>

      <!-- Burn removes packages in reverse chain order. Keep a second,
           install-only invocation of the verified preflight helper at the
           tail so uninstall quiesces DS4Windows before any owned package is
           removed. VIIPER alone owns broker shutdown inside its transaction. -->
      <ExePackage
          Id="CloseRunningApplicationsForUninstall"
          CacheId="DS4WindowsSetupActionsUninstallPreflight-$(var.SetupActionsHash)"
          Name="DS4Windows.SetupActions.UninstallPreflight.exe"
          SourceFile="$(var.SetupActionsPath)"
          PerMachine="yes"
          Permanent="yes"
          Vital="yes"
          DetectCondition="0"
          InstallArguments="native-preflight --correlation-id &quot;[SetupCorrelationId]&quot;">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Behavior="error" />
      </ExePackage>
    </Chain>
  </Bundle>

  <Fragment>
    <PayloadGroup Id="NativeViiperRuntimePayloads">
      <Payload Id="NativeViiperBrokerPayload"
               SourceFile="$(var.ExtrasRoot)\viiper-native-udecx\viiper.exe"
               Name="viiper-native-udecx\viiper.exe" />
      <Payload Id="NativeViiperHelperPayload"
               SourceFile="$(var.ExtrasRoot)\viiper-native-udecx\ViiperUdeCtl.exe"
               Name="viiper-native-udecx\ViiperUdeCtl.exe" />
      <Payload Id="NativeViiperManifestPayload"
               SourceFile="$(var.ExtrasRoot)\viiper-native-udecx\submission-manifest.json"
               Name="viiper-native-udecx\submission-manifest.json" />
      <Payload Id="NativeViiperInfPayload"
               SourceFile="$(var.ExtrasRoot)\viiper-native-udecx\driver\ViiperUde.inf"
               Name="viiper-native-udecx\driver\ViiperUde.inf" />
      <Payload Id="NativeViiperSysPayload"
               SourceFile="$(var.ExtrasRoot)\viiper-native-udecx\driver\ViiperUde.sys"
               Name="viiper-native-udecx\driver\ViiperUde.sys" />
      <Payload Id="NativeViiperCatPayload"
               SourceFile="$(var.ExtrasRoot)\viiper-native-udecx\driver\ViiperUde.cat"
               Name="viiper-native-udecx\driver\ViiperUde.cat" />
      <Payload Id="NativeViiperLockPayload"
               SourceFile="$(var.ExtrasRoot)\viiper-native-udecx.lock.json"
               Name="viiper-native-udecx.lock.json" />
    </PayloadGroup>
  </Fragment>
</Wix>
